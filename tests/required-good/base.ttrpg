BASE "Required_Core" {
    NAME "DECISION-34 fixture — REQUIRED: every entry of a type has the property (§8)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #   ttrpg_validator.py tests/required-good       0 errors, 0 warnings

    # every entry of this type has a roll and a text; that is what REQUIRED says
    #ReqEntryK2vQ9wN3cL7pXdAa ^"Roll Table Entry" DEF {
        PROPERTIES {
            ^"Roll" STRING REQUIRED
            ^"Text" STRING REQUIRED
            ^"Note" STRING
        }
    }

    #ReqSchoolB8tJ1yL4sD5fG0z ^"School" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Clan" STRING REQUIRED
        }
    }

    # a type between the two gives the value for everything below it
    #ReqCraneC4pH7zR2wE9uX1qW ^"Crane School" DEF {
        EXTENDS #ReqSchoolB8tJ1yL4sD5fG0z ^"School"
        PROPERTIES {
            ^"Clan" STRING "Crane" FIXED
        }
    }

    #ReqVirtueD4fG7hJ0kL2mNpS ^"Virtue" DEF {
        PARAMETERS { ^"Size" OF ["Major", "Minor"] }
        PROPERTIES {
            ^"Size" STRING REQUIRED
        }
    }

    # written on the instance
    #ReqRowOneE1vP5xJ9cL2sQ7w ^"Row 1" DEF {
        EXTENDS #ReqEntryK2vQ9wN3cL7pXdAa ^"Roll Table Entry"
        PROPERTIES {
            ^"Roll" STRING "1-3"
            ^"Text" STRING "A stranger arrives."
        }
    }

    # ^"Name" is answered by the DEF's own name; ^"Clan" by the type above
    #ReqKakitaF6gP2tR8mX4cJ1q ^"Kakita Duelist" DEF {
        EXTENDS #ReqCraneC4pH7zR2wE9uX1qW ^"Crane School"
        PROPERTIES {
            ^"Rank" INTEGER 1
        }
    }

    # the book prints this one with no clan: FIAT says so
    #ReqGanzuG9hT3yW7zK5vBn2M ^"Ganzu Guardian Tradition" DEF {
        EXTENDS #ReqSchoolB8tJ1yL4sD5fG0z ^"School"
        FIAT "Path of Waves traditions belong to no clan."
        PROPERTIES {
            ^"Rank" INTEGER 1
        }
    }

    # ^"Size" is a PARAMETERS slot: the reference supplies it
    #ReqWrathfulH2nV6kQ9wX3mC ^"Wrathful" DEF {
        EXTENDS #ReqVirtueD4fG7hJ0kL2mNpS ^"Virtue"
        PROPERTIES {
            ^"Cost" INTEGER 3
        }
    }

    # a subtype declares and gives no value: it is a type, and owes nothing
    #ReqTraditionJ7mQ2xW9vN4c ^"Tradition" DEF {
        EXTENDS #ReqSchoolB8tJ1yL4sD5fG0z ^"School"
        PROPERTIES {
            ^"Region" STRING
        }
    }
}
