// DECISION-61 fixture (§19, §21) — each side names its corpus's content version: 0 errors, 0 warnings.
//   ttrpg_validator.py tests/sides/good.bridge --corpus sides-old=tests/sides/old --corpus sides-new=tests/sides/new
BRIDGE "Sides_Good_Bridge" {
    NAME "Converting from the old edition to the new"
    VERSION "1.0"
    SPEC_VERSION "0.6"
    RELEASE_DATE "2026-11-14"

    ORIGIN      "sides-old" VERSION "0.4"
    DESTINATION "sides-new" VERSION "0.5"

    DISPOSITIONS {
        #SdbRenamedB7c8D9e1F2g3H4 ^"Renamed" DEF {
            ^"Description" "The entity kept its rules and changed its name."
        }
    }

    CONVERSION {
        MAP {
            ORIGIN      ^"Ride"
            DESTINATION ^"Drive"
            DISPOSITION [ ^"Renamed" ]
        }
    }
}
