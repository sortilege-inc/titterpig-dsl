BASE "Sites_Core" {
    NAME "DECISION-44 fixture — references in lists and in system blocks (§5d)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-13"

    #   ttrpg_validator.py tests/sites-good          0 errors, 0 warnings
    #   check_grammar.py   tests/sites-good          accepted

    #SitVirtueK2vQ9wN3cL7pA5 ^"Virtue" DEF { }
    #SitSightH4mK8wQ2xN6vB1t ^"Second Sight" DEF { EXTENDS #SitVirtueK2vQ9wN3cL7pA5 ^"Virtue" }
    #SitLuckR5tJ1yL8sD4fG0zX ^"Luck" DEF { EXTENDS #SitVirtueK2vQ9wN3cL7pA5 ^"Virtue" }
    #SitGripB9pK3xN7vM2cQ6hW ^"Lord Hida's Grip" DEF { }

    #SitGrogP7cJ3yT9hL5sD2fA ^"Shield Grog" DEF {
        # a member of a list is a reference: hash and name
        ^"Favoured" [ #SitSightH4mK8wQ2xN6vB1t ^"Second Sight", #SitLuckR5tJ1yL8sD4fG0zX ^"Luck" ]
        ^"Virtues" LIST OF #SitVirtueK2vQ9wN3cL7pA5 ^"Virtue" [
            #SitSightH4mK8wQ2xN6vB1t ^"Second Sight",
            #SitLuckR5tJ1yL8sD4fG0zX ^"Luck"
        ]
        # a name inside an unnamed record is that record's property
        ^"Key" [
            DEF { ^"Marker" "1."  ^"Place" "Lower Elevator" },
            DEF { ^"Marker" "2." }
        ]
        # in a system block, a hash and name pair is a reference
        KATA #SitGripB9pK3xN7vM2cQ6hW ^"Lord Hida's Grip"
        QUALITIES {
            #SitSightH4mK8wQ2xN6vB1t ^"Second Sight"
        }
        # and a name with no hash is the system's own: a label, a key
        SPEND ^"Special" "The target must be grabbed."
        TRAITS {
            ^"Stubborn"
        }
        # the book lists a virtue it never defines: FIAT says so
        ^"Printed" [ ^"Virtue of the Lost Appendix" ] FIAT "The book lists it and prints no entry."
    }
}
