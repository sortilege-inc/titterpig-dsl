BASE "Guidance_Bad_Core" {
    NAME "DECISION-51 and DECISION-63 fixture — four faults in the spans of a guidance ENTRY (§22, §5c)"
    SPEC_VERSION "0.6"
    EDITION "demo"
    VERSION "1.0"
    RELEASE_DATE "2026-11-13"

    #   check_references.py  tests/guidance-bad      4 errors

    #GubReputationK2vQ9wN3cL ^"Mutant Reputation Effects" DEF {
        DESCRIPTION "A mutant's reputation changes how strangers react."
        GUIDANCE {
            # fault 1 — the span is in no text at all
            ENTRY ^"example-1" #GubEntryOneH4mK8wQ2xN6 {
                CONCERNS [ #GubReputationK2vQ9wN3cL ^"Mutant Reputation Effects" ]
                TEXT "Example: Wolverine is sneaking through a back alley."
                EMPHASIS BOLD {
                    "For instance:"
                }
            }
            # fault 2 — the span is in the DEF's DESCRIPTION and not in this entry's TEXT
            ENTRY ^"example-2" #GubEntryTwoR5tJ1yL8sD4 {
                TEXT "Example: a shopkeeper refuses to serve her."
                EMPHASIS BOLD {
                    "reputation"
                }
            }
            # fault 3 — a REFERENCES span that is not in this entry's TEXT (DECISION-63)
            ENTRY ^"sidebar-1" #GubEntryThreeW6xY8zA1b {
                TEXT "A mutant unsettles a crowd before anyone speaks."
                REFERENCES {
                    "Fearsome" -> #GubReputationK2vQ9wN3cL ^"Mutant Reputation Effects"
                }
            }
            # fault 4 — a REFERENCES target that is no entity
            ENTRY ^"sidebar-2" #GubEntryFourC2d3E4f5G6 {
                TEXT "A Fearsome mutant unsettles a crowd."
                REFERENCES {
                    "Fearsome" -> ^"No Such Trait"
                }
            }
        }
    }
}
