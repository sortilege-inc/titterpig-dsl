EXTENSION "Values_Bad_15" {
    NAME "fault 15 — arguments to a DEF that declares no PARAMETERS, named by its hash where its name is two DEFs'"
    SPEC_VERSION "0.6"
    EDITION "demo"
    VERSION "1.0"
    RELEASE_DATE "2026-11-26"
    DEPENDS_ON "Values_Bad_Core"

    # two DEFs named "Steady": by name alone a bound reference's base is ambiguous, by its hash it is not
    #ValSteadyOneK3mP8qR2sT5vW ^"Steady" DEF { EXTENDS #ValVirtueT5wZ1qE8uH3jL6p ^"Virtue" }
    #ValSteadyTwoQ8wE3rT6yU1iO ^"Steady" DEF {
        EXTENDS #ValVirtueT5wZ1qE8uH3jL6p ^"Virtue"
        PARAMETERS { ^"circumstantial" }
    }

    #ValBad15Hk4Lm7Np2Qr5St8V ^"Tadaji 15" DEF {
        EXTENDS #ValActorH2nV6kQ9wX3mC7pL ^"Samurai"
        PROPERTIES {
            ^"Name" "Tadaji"
            ^"Air" 2
        }
        ^"Flaws" [ #ValSteadyOneK3mP8qR2sT5vW ^"Steady"("x") ]  # ERROR
    }
}
