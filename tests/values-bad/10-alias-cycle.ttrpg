EXTENSION "Values_Bad_10" {
    NAME "fault 10 — an ALIAS cycle"
    # 0.5: a cycle can be written only in the form older than 0.6, an alias FOR a name
    # (DECISION-57). The two cycle errors stand at every version; the form adds two warnings.
    SPEC_VERSION "0.5"
    EDITION "demo"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"
    DEPENDS_ON "Values_Bad_Core"

    ALIAS ^"AlA" FOR ^"AlB"                                      # ERROR
    ALIAS ^"AlB" FOR ^"AlA"                                      # ERROR
}
