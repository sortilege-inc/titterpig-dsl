BASE "Demo_Markdown_Good" {
    NAME "DECISION-19 fixture — asterisks a book prints, and a FIAT for the ones that look like Markdown"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    # none of these is Markdown emphasis, and none is flagged
    #MdGoodFootnotesAAAAAAAAAA ^"Sympathetic Connections" DEF {
        DESCRIPTION "* Baptismal names cannot be used in sympathetic magic.\n** Caster must know the target's current location.\n*** Casting such a horoscope takes an hour."
        PROPERTIES {
            ^"Skills" STRING "Awareness 20 (+1), Chirurgery 20*, Clerk 20* (Gift of Tongues, all languages)"
            ^"Key" STRING "* indicates a Weapon that requires at least two hands to use."
            ^"Area" STRING "5*3*2 paces, or 2 * 3 * 4 for a large room"
            ^"Stars" STRING "Rated ** by the guild and *** by the crown."
        }
    }

    # a pair of printed asterisks reads as a span; FIAT records that the source prints them
    #MdGoodExcusedBBBBBBBBBBBB ^"Weapons Key" DEF {
        PROPERTIES {
            ^"Marks" STRING "Weapons marked *thus* need two hands." FIAT "printed asterisks: the book marks two-handed weapons this way"
            ^"Note" STRING "see *Rock and *Sling* above" FIAT "printed asterisks"
        }
    }
    #MdGoodElementCCCCCCCCCCCC ^"Errata Note" DEF {
        FIAT "the source prints these asterisks as footnote marks"
        DESCRIPTION "Costs marked *thus* are doubled in winter."
    }
}
