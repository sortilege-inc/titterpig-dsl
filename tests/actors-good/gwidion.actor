EXTENSION "Actors_Gwidion" {
    NAME "Gwidion of Verditius"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"
    DEPENDS_ON "Actors_Core"

    # one character in several states: the later one extends the earlier
    #ActGwidionA2mK6vQ9xN3cW7 ^"Gwidion at Gauntlet" DEF {
        EXTENDS #ActMagusP3tH8yL5sD1fG6b ^"Magus"
        PROPERTIES {
            ^"Name" "Gwidion"
            ^"Age" 25
        }
    }

    #ActGwidionB8tJ1yL4sD5fG0 ^"Gwidion +15 Years" DEF {
        EXTENDS #ActGwidionA2mK6vQ9xN3cW7 ^"Gwidion at Gauntlet"
        PROPERTIES {
            ^"Age" 40
        }
    }

    # an instance of a type that is not an ACTOR type
    #ActSemitaC4pH7zR2wE9uX1 ^"Semita Errabunda" DEF {
        EXTENDS #ActCovenantR9cJ4nB7xV2kM ^"Covenant"
        PROPERTIES {
            ^"Aura" 3
        }
    }
}
