BASE "Actors_Core" {
    NAME "DECISION-28 fixture — an .actor file is an EXTENSION file of instances (§2)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #   ttrpg_validator.py tests/actors-good         0 errors, 0 warnings

    #ActAdversaryK7mQ2xW9vN4c ACTOR "Adversary" DEF {
        PROPERTIES {
            ^"Name" STRING
            ^"Attribute Level" INTEGER MIN 1
        }
    }

    #ActMagusP3tH8yL5sD1fG6b ACTOR "Magus" DEF {
        PROPERTIES {
            ^"Name" STRING
            ^"Age" INTEGER MIN 0
        }
    }

    # a type that is not an ACTOR type; its instances may still stand in an .actor file
    #ActCovenantR9cJ4nB7xV2kM ^"Covenant" DEF {
        PROPERTIES {
            ^"Aura" INTEGER MIN 0
        }
    }
}
