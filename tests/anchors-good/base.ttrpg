BASE "Demo_Anchors_Base" {
    NAME "DECISION-24 fixture — what a reference may point at (§20)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    # Run both tools:
    #   ttrpg_validator.py tests/anchors-good
    #   check_references.py tests/anchors-good

    #AncDemoNpcTypeAAAAAAAAAAA ^"NPC" DEF { }

    # from another file, a named block is reached by its hash
    #AncDemoGuideBBBBBBBBBBBBB ^"Pilgrim's Guide" DEF {
        DESCRIPTION "The road ends at the Mountain Song Temple, where the Tea Ceremony is held for the Ifrit King."
        REFERENCES {
            "Mountain Song Temple" -> #AncDemoTempleCCCCCCCCCCC ^"Mountain Song Temple"
            "Tea Ceremony"         -> #AncDemoCeremonyDDDDDDDDD ^"Tea Ceremony"
            "Ifrit King"           -> #AncDemoIfritEEEEEEEEEEEE ^"Ifrit King"
            "The road"             -> #AncDemoPoetHHHHHHHHHHHHHH ^"Mrinmoy \"Vidyapati\" Mishra"
        }
        EFFECT "Pilgrims leave an offering at the #AncDemoTempleCCCCCCCCCCC ^\"Mountain Song Temple\"."
    }
}
