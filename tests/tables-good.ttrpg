BASE "Demo_Tables" {
    NAME "DECISION-21 fixture — TABLE, AXIS, AT, COLUMNS (§5e)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"
    DEPENDS_ON "Titterpig_Dice"

    # Validate with the dice module passed alongside:
    #   ttrpg_validator.py tests/tables-good.ttrpg modules/0.6/

    #TblDemoOddsAAAAAAAAAAAAAA ^"Odds" DEF { }
    #TblDemoCertainBBBBBBBBBBB ^"Certain" DEF { EXTENDS #TblDemoOddsAAAAAAAAAAAAAA ^"Odds" }
    #TblDemoLikelyCCCCCCCCCCCC ^"Likely" DEF { EXTENDS #TblDemoOddsAAAAAAAAAAAAAA ^"Odds" }
    #TblDemoHubrisDDDDDDDDDDDD ^"Hubris" DEF { MIN 0 }
    #TblDemoForgivenEEEEEEEEEE ^"Forgiven" DEF { }

    # two axes, one of entities and one a range; each cell holds several values
    #TblDemoFateChartFFFFFFFFF ^"Fate Chart" DEF {
        TABLE {
            AXIS ^"Odds" OF #TblDemoOddsAAAAAAAAAAAAAA ^"Odds"
            AXIS ^"Chaos Factor" 1-9
            AT [ #TblDemoCertainBBBBBBBBBBB ^"Certain", 1 ]   { ^"Exceptional Yes" 10  ^"Yes" 50  ^"Exceptional No" 91 }
            AT [ #TblDemoCertainBBBBBBBBBBB ^"Certain", 2-9 ] { ^"Exceptional Yes" 13  ^"Yes" 65  ^"Exceptional No" 94 }
            AT [ #TblDemoLikelyCCCCCCCCCCCC ^"Likely", ANY ]  { ^"Exceptional Yes" 5   ^"Yes" 25  ^"Exceptional No" 86 }
        }
    }

    # one axis that is a roll; ranges, an open range, and results that change a value or name an entity
    #TblDemoPunishmentGGGGGGGG ^"Punishment of the Gods" DEF {
        TABLE {
            AXIS ^"Roll" ROLL 2 OF #tbgOQaN6xUuzn8GiibKkGw62 ^"d10"
            AT [ 2 ]      { ^"Punishment" REF #TblDemoForgivenEEEEEEEEEE ^"Forgiven"  #TblDemoHubrisDDDDDDDDDDDD ^"Hubris" TRANSFORM SUBTRACT 1 }
            AT [ 3-7 ]    { ^"Punishment" "No effect" }
            AT [ 8-15 ]   { ^"Punishment" "Cursed"
                            TABLE {
                                AXIS ^"Curse" ROLL 1 OF #tbgOQaN6xUuzn8GiibKkGw62 ^"d10"
                                AT [ MAX 5 ] { ^"Curse" "Blindness" }
                                AT [ MIN 6 ] { ^"Curse" "Madness" }
                            } }
            AT [ MIN 16 ] { ^"Punishment" "Struck down" }
        }
    }

    # an axis that lists its points, and an axis of any whole number
    #TblDemoFatigueHHHHHHHHHHH ^"Wound to Fatigue" DEF {
        TABLE {
            AXIS ^"Wound" [ "Light", "Medium", "Heavy" ]
            AXIS ^"Rounds"
            AT [ "Light", MAX 3 ]  { ^"Fatigue Levels" 1 }
            AT [ "Light", MIN 4 ]  { ^"Fatigue Levels" 2 }
            AT [ "Medium", ANY ]   { ^"Fatigue Levels" 2 }
            AT [ "Heavy", ANY ]    { ^"Fatigue Levels" 3 }
        }
    }

    # a table of records: the rows are the entities of a type, the columns its properties
    #TblDemoArmorIIIIIIIIIIIII ^"Armor" DEF {
        PROPERTIES {
            ^"Protection" REQUIRED
            ^"Load" REQUIRED
            ^"Cost"
        }
    }
    #TblDemoChainMailJJJJJJJJJ ^"Chain Mail" DEF {
        EXTENDS #TblDemoArmorIIIIIIIIIIIII ^"Armor"
        PROPERTIES { ^"Protection" 9  ^"Load" 6  ^"Cost" "Exp." }
    }
    #TblDemoArmorTableKKKKKKKK ^"Armor Table" DEF {
        TABLE {
            AXIS ^"Armor" OF #TblDemoArmorIIIIIIIIIIIII ^"Armor"
            COLUMNS [ ^"Protection", ^"Load", ^"Cost" ]
        }
    }
}
