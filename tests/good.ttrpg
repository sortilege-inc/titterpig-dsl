BASE "Demo_Core" {
    NAME "Demo System Core"
    SPEC_VERSION "0.4"
    VERSION "1.0"
    RELEASE_DATE "2026-07-12"

    #DemoEntity7k3nP8mQ2vX7wZ ACTOR "Entity" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
        }
    }

    #DemoSamurai9tB4cD1eF6gH8i ACTOR "Samurai" DEF {
        EXTENDS #DemoEntity7k3nP8mQ2vX7wZ ^"Entity"
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
        }
    }

    #DemoAdversaryJ0kL2mN4oP6qR ACTOR "Adversary" DEF {
        EXTENDS #DemoEntity7k3nP8mQ2vX7wZ ^"Entity"
        PROPERTIES {
            ^"Name" STRING REQUIRED
        }
    }

    # ordinary NPC instance — extends the (looser) Adversary type
    #DemoNpcQ4sT6uW8xY0zA2bC4d ^"Kuni Watcher" DEF {
        EXTENDS ^"Adversary"
        PROPERTIES {
            ^"Name" STRING "Kuni Watcher"
            ^"Air" INTEGER 3
        }
    }

    # a type an EXTENSION will widen (§13). The ENUM and LIST properties are what
    # give SET / ADD_TO / REMOVE_FROM something to act on; see tests/mods-*.ttrpg
    #DemoTechniqueM5nO7pQ9rS1tU3v ^"Technique" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Ring" ENUM ["Air", "Earth", "Fire", "Water"]
            ^"Tags" LIST ["kata", "shuji", "ritual"]
            ^"Rank" INTEGER MIN 1 MAX 5
        }
    }

    # an instance of it — restates the parent's ENUM field as a concrete value, which
    # is what an enum-narrowing check has to notice
    #DemoCrossingBladeW7xY9zA1bC3 ^"Crossing Blade" DEF {
        EXTENDS ^"Technique"
        PROPERTIES {
            ^"Name" STRING "Crossing Blade"
            ^"Ring" STRING "Water"
            ^"Rank" INTEGER 2
        }
    }

    # FIAT exception — supernatural Air beyond the mortal MAX 5
    #DemoOniLordC3dE5fG7hI9jK1l ^"Oni Lord" DEF {
        EXTENDS ^"Adversary"
        FIAT "Supernatural entity; stats intentionally exceed mortal limits"
        PROPERTIES {
            ^"Name" STRING "Oni Lord"
            ^"Air" INTEGER 8 MIN 1 MAX 5 FIAT "supernatural Air"
        }
    }
}
