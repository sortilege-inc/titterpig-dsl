BASE "Demo_NarBad_Base" {
    NAME "DECISION-22 fixture (bad set) — the base the narrative files depend on"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #NarBadXSceneTypeMMMMMMMMM ^"Scene Type" DEF { }
    #NarBadXRoleplayNNNNNNNNNN ^"Roleplay" DEF { EXTENDS #NarBadXSceneTypeMMMMMMMMM ^"Scene Type" }

    #NarBadXNpcTypeAAAAAAAAAAA ^"NPC" DEF {
        PROPERTIES {
            ^"Role"
            ^"Rings" DEF {
                ^"Air" MIN 1 MAX 5 DEFAULT 1
                ^"Fire" MIN 1 MAX 5 DEFAULT 1
            }
            # a skill group is a property of a character
            ^"Skills" DEF {
                ^"Artisan" MIN 0 DEFAULT 0
                ^"Martial" MIN 0 DEFAULT 0
                ^"Social" MIN 0 DEFAULT 0
            }
        }
    }
}
