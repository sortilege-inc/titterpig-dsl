BASE "Values_Core" {
    NAME "DECISION-32 fixture — values against what a definition extends (§5, §5b, §6, §8)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #   ttrpg_validator.py tests/values-good         0 errors, 0 warnings
    #   check_constructs.py tests/values-good        0 errors

    #ValActorH2nV6kQ9wX3mC7pL ACTOR "Samurai" DEF {
        PROPERTIES {
            ^"Name"
            ^"Air" MIN 1 MAX 5 DEFAULT 1
            ^"Kind" ENUM ["Gift", "Burden"]
            ^"Skills" LIST OF #ValSkillR5tJ1yL8sD4fG0zX ^"Skill"
            ^"Weight"
        }
    }
    #ValSkillR5tJ1yL8sD4fG0zX ^"Skill" DEF { MIN 0 MAX 5 }
    #ValKenjutsuB9pK3xN7vM2cQ ^"Kenjutsu" DEF { EXTENDS #ValSkillR5tJ1yL8sD4fG0zX ^"Skill" }
    #ValVirtueT5wZ1qE8uH3jL6p ^"Virtue" DEF { }
    #ValWrathfulC4pH7zR2wE9uX ^"Wrathful" DEF {
        EXTENDS #ValVirtueT5wZ1qE8uH3jL6p ^"Virtue"
        PARAMETERS { ^"Size" OF ["Major", "Minor"] }
    }
    #ValPlainA2mK6vQ9xN3cW7yD ^"Plain" DEF { EXTENDS #ValVirtueT5wZ1qE8uH3jL6p ^"Virtue" }
}
