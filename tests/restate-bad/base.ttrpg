BASE "Restate_Bad_Core" {
    NAME "DECISION-27 fixture — a DEF's hash stated twice (§13, §20)"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #   ttrpg_validator.py tests/restate-bad         3 errors
    #
    # Before v0.6 the spec read fault 1 as an implicit override. It is a duplicate anchor.

    #RstBadBladeH2nV6kQ9wX3mC7 ^"Crossing Blade" DEF {
        DESCRIPTION "A cross-body cut."
    }

    #RstBadWatchR5tJ1yL8sD4fG0 ^"Kuni Watcher" DEF {
        DESCRIPTION "A sentry on the Wall."
    }

    # fault 3 — the same hash twice in one file                              ERROR
    #RstBadTwiceB9pK3xN7vM2cQ6 ^"Rising Blade" DEF {
        DESCRIPTION "An upward cut."
    }
    #RstBadTwiceB9pK3xN7vM2cQ6 ^"Rising Blade" DEF {
        DESCRIPTION "An upward cut, pasted a second time."
    }
}
