EXTENSION "Restate_Bad_Later" {
    NAME "DECISION-27 fixture — a later file that restates two hashes"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"
    DEPENDS_ON "Restate_Bad_Core"

    # fault 1 — a new DEF under a hash the corpus declares, same name        ERROR
    # (write MODIFY #RstBadBladeH2nV6kQ9wX3mC7 ^"Crossing Blade" { SET DESCRIPTION "…" })
    #RstBadBladeH2nV6kQ9wX3mC7 ^"Crossing Blade" DEF {
        DESCRIPTION "A cross-body cut, as the second book prints it."
    }

    # fault 2 — the same hash under another name                             ERROR
    #RstBadWatchR5tJ1yL8sD4fG0 ^"Kuni Sentry" DEF {
        DESCRIPTION "A sentry on the Wall."
    }
}
