BASE "Alias_Bad_New" {
    NAME "DECISION-57 fixture — aliases that are not a second name of a hash, in a file that declares 0.6"
    SPEC_VERSION "0.6"
    EDITION "demo"
    VERSION "1.0"
    RELEASE_DATE "2026-11-14"

    # Run:
    #   ttrpg_validator.py tests/alias-bad
    #   check_references.py tests/alias-bad

    #AlbAdvantageA1b2C3d4E5f6 ^"Advantage" DEF { }

    #AlbNinjoG7h8J9k1M2n3P4q5 ^"Ninjō" DEF {
        # ERROR: a line inside the DEF declares nothing
        ALIAS "Ninjo"
        EXTENDS #AlbAdvantageA1b2C3d4E5f6 ^"Advantage"
        DESCRIPTION "A samurai's personal desire."
    }

    # ERROR: the target is named with no hash
    ALIAS ^"Desire" FOR ^"Ninjō"

    # ERROR: the hash is no anchor
    ALIAS ^"Want" FOR #AlbNoSuchHashZ9y8X7w6V5

    # ERROR: the hash is the anchor of another name
    ALIAS ^"Wish" FOR #AlbNinjoG7h8J9k1M2n3P4q5 ^"Advantage"

    #AlbGiriR6s7T8u9V1w2X3y4 ^"Giri" DEF {
        EXTENDS #AlbAdvantageA1b2C3d4E5f6 ^"Advantage"
        DESCRIPTION "Giri pulls against Yearning."
        REFERENCES {
            # ERROR (check_references.py): no alias gives the hash that name
            "Yearning" -> #AlbNinjoG7h8J9k1M2n3P4q5 ^"Yearning"
        }
    }
}
