EXTENSION "Restate_Strider" {
    NAME "DECISION-27 fixture — the same name under another hash is a second entity"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"
    DEPENDS_ON "Restate_Core"

    # The core file defines ^"Combat". This one is a different entity of the same name: it replaces
    # nothing, and each reference says which one it means by its hash.
    #RstStriderCbtW6qH3mT8zK4n ^"Combat" DEF {
        DESCRIPTION "Combat for a lone hero."
    }

    #RstStriderRefE1vP5xJ9cL2s ^"Strider Mode" DEF {
        DESCRIPTION "Solo play changes Combat. The rest of Combat stands as the core rules print it."
        REFERENCES {
            "Combat" -> #RstStriderCbtW6qH3mT8zK4n ^"Combat"
            "Combat" -> #RstCoreCombatY8bN4gR7dF1u ^"Combat"
        }
    }
}
