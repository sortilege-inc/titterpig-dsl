BASE "Demo_Narrative_Base" {
    NAME "DECISION-22 fixture — the base the narrative files depend on"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    # scene types and conflict types are entities the system defines (§16)
    #NarDemoSceneTypeMMMMMMMMM ^"Scene Type" DEF { }
    #NarDemoRoleplayNNNNNNNNNN ^"Roleplay" DEF { EXTENDS #NarDemoSceneTypeMMMMMMMMM ^"Scene Type" }
    #NarDemoInvestigOOOOOOOOOO ^"Investigation" DEF { EXTENDS #NarDemoSceneTypeMMMMMMMMM ^"Scene Type" }
    #NarDemoCombatPPPPPPPPPPPP ^"Combat" DEF { EXTENDS #NarDemoSceneTypeMMMMMMMMM ^"Scene Type" }
    #NarDemoConflictTQQQQQQQQQ ^"Conflict Type" DEF { }
    #NarDemoSkirmishRRRRRRRRRR ^"Skirmish" DEF { EXTENDS #NarDemoConflictTQQQQQQQQQ ^"Conflict Type" }
    #NarDemoIntrigueSSSSSSSSSS ^"Intrigue" DEF { EXTENDS #NarDemoConflictTQQQQQQQQQ ^"Conflict Type" }

    #NarDemoNpcTypeAAAAAAAAAAA ^"NPC" DEF {
        PROPERTIES {
            ^"Role" STRING
            ^"Rings" DEF {
                ^"Air" INTEGER MIN 1 MAX 5 DEFAULT 1
                ^"Fire" INTEGER MIN 1 MAX 5 DEFAULT 1
            }
            # a skill group is a property of a character
            ^"Skills" DEF {
                ^"Artisan" INTEGER MIN 0 DEFAULT 0
                ^"Martial" INTEGER MIN 0 DEFAULT 0
                ^"Social" INTEGER MIN 0 DEFAULT 0
            }
        }
    }
}
