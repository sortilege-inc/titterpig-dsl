CAMPAIGN "Demo_Narrative_Campaign" {
    NAME "DECISION-22 fixture — a campaign names its arcs with FROM ARC"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    DEPENDS_ON "Demo_Narrative_Base"

    RECURRING_CAST {
        FROM FRAME "Demo_Narrative_Frame" INCLUDE [ #NarDemoPublisherDDDDDDDDD ^"The Publisher" ]
    }
    FROM ARC "Demo_Narrative_Arc"
}
