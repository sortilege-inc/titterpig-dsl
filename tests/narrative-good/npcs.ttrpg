EXTENSION "Demo_Narrative_NPCs" EXTENDS "Demo_Narrative_Base" {
    NAME "DECISION-22 fixture — people an arc imports"
    SPEC_VERSION "0.6"
    VERSION "1.0"
    RELEASE_DATE "2026-11-12"

    #NarDemoGovernorBBBBBBBBBB ^"The Governor" DEF {
        EXTENDS #NarDemoNpcTypeAAAAAAAAAAA ^"NPC"
        PROPERTIES {
            ^"Role" STRING "Governor of the city"
            ^"Rings" DEF { ^"Air" INTEGER 4  ^"Fire" INTEGER 4 }
            ^"Skills" DEF { ^"Artisan" INTEGER 3  ^"Martial" INTEGER 2  ^"Social" INTEGER 4 }
        }
    }
    #NarDemoSpiritCCCCCCCCCCCC ^"The Spirit" DEF {
        EXTENDS #NarDemoNpcTypeAAAAAAAAAAA ^"NPC"
    }
}
