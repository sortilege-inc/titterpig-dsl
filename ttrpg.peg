# ┌────────────────────────────────────────────────────────────────────┐
# │ Titterpig DSL — PEG Grammar, v0.5 (aligned to titterpig-dsl-spec.md).  │
# │ v0.4 additions: SPEC_VERSION metadata; FIAT (property-level modifier   │
# │ and element-level cascading statement). The hash-ID >=16-char rule   │
# │ and cross-file coherence are enforced by the validator, not here.    │
# └────────────────────────────────────────────────────────────────────┘
#
# Titterpig DSL — PEG Grammar (Bryan Ford notation)
# Formal syntax specification for .ttrpg files (v0.5)
# v0.5 additions (§3c): REFERENCES (renames MENTIONS) + REFERENCED BY; GUIDANCE in a
# DEF/module body (generalized from BRIDGE); HOOKS + FORMALITY; OPTIONAL; the
# SELECTIONS container for .selections files.
#
# This grammar defines syntactically valid .ttrpg files. Semantic rules
# (hash uniqueness, EXTENDS resolution, type consistency) are enforced
# by the validator, not this grammar.
#
# Conventions:
#   UPPER_CASE  = rule names
#   'literal'   = terminal strings
#   [...]       = character class
#   !e          = not-predicate
#   &e          = and-predicate
#   e*          = zero or more
#   e+          = one or more
#   e?          = optional
#   e1 / e2     = ordered choice
#   (e)         = grouping

# ═══════════════════════════════════════════════════════════
# 1. File-Level Structure
# ═══════════════════════════════════════════════════════════

FILE            <- _ (BASE_BLOCK / EXTENSION_BLOCK / BRIDGE_BLOCK / SELECTIONS_BLOCK) _ EOF

BASE_BLOCK      <- 'BASE' _ STRING _ '{' _ BODY _ '}'
EXTENSION_BLOCK <- 'EXTENSION' _ STRING _ EXTENDS_CLAUSE? _ '{' _ BODY _ '}'

EXTENDS_CLAUSE  <- 'EXTENDS' _ STRING

BODY            <- (BODY_ENTRY _)*

BODY_ENTRY      <- METADATA
                 / ALIAS_STATEMENT
                 / DEF_BLOCK
                 / PROPERTIES_BLOCK
                 / PARAMETERS_BLOCK
                 / RULES_BLOCK
                 / REFERENCES_BLOCK          # v0.5, §5c — renamed from MENTIONS
                 / REFERENCED_BY_BLOCK       # v0.5, §5c — optional inverse mirror
                 / GUIDANCE_BLOCK            # v0.5, §22 — generalized from BRIDGE
                 / HOOKS_BLOCK               # v0.5, §23 — conditional emit hooks
                 / OPTIONAL_BLOCK            # v0.5, §24 — optional/variant rule marker
                 / APPLIES_TO_CLAUSE
                 / EXTENDS_DECL
                 / FIAT_STATEMENT
                 / BARE_TYPE_CONSTRAINT
                 / MODIFY_STATEMENT
                 / OVERRIDE_STATEMENT
                 / ADD_STATEMENT
                 / GENERIC_BLOCK
                 / INLINE_VALUE
                 / COMMENT

# ═══════════════════════════════════════════════════════════
# 2. Metadata
# ═══════════════════════════════════════════════════════════

METADATA        <- NAME_DECL / SPEC_VERSION_DECL / VERSION_DECL / RELEASE_DATE_DECL / DEPENDS_ON_DECL

NAME_DECL       <- 'NAME' _ STRING
SPEC_VERSION_DECL <- 'SPEC_VERSION' _ STRING
VERSION_DECL    <- 'VERSION' _ STRING
RELEASE_DATE_DECL <- 'RELEASE_DATE' _ STRING
DEPENDS_ON_DECL <- 'DEPENDS_ON' _ STRING (_ 'VERSION' _ STRING)?

# ═══════════════════════════════════════════════════════════
# 3. Definitions (DEF)
# ═══════════════════════════════════════════════════════════

# All DEF forms:
#   ^"Name" DEF { ... }
#   #hash ^"Name" DEF { ... }
#   #hash ACTOR "Name" DEF { ... }
#   #hash TEMPLATE "Name" DEF { ... }
#   #hash "Name" DEF { ... }
#   ^"Name" DEF { ... }          (no hash)
#   "Name" DEF { ... }           (rare, no caret)

DEF_BLOCK       <- HASH_ID? _ ACTOR_KW? _ DEF_NAME _ 'DEF' _ '{' _ BODY _ '}'

ACTOR_KW        <- 'ACTOR' / 'TEMPLATE'
DEF_NAME        <- CARET_REF / STRING

# ─────────────────────────────────────────────────────────────
# 3b. Parameterized definitions & aliases (v0.4, DECISION-6)
# ─────────────────────────────────────────────────────────────

# A DEF may declare typed parameter slots that bound references fill.
#   ^"Puissant" DEF { PARAMETERS { ^"subject" OF ^"Ability" } ... }
# A parameter domain is a caret type (bound value must be an entity of that
# type) or STRING (free text, e.g. a place name).
PARAMETERS_BLOCK <- 'PARAMETERS' _ '{' _ (PARAM_DECL _)* '}'
# A parameter's domain is a caret type (bound value is an entity of that type),
# STRING (free text), or a bracket list (an enum of literal allowed values,
# e.g. selecting a Major-or-Minor virtue's severity: ^"Size" OF ["Major","Minor"]).
PARAM_DECL       <- CARET_REF _ 'OF' _ (CARET_REF / 'STRING' / BRACKET_LIST)

# ALIAS declares one name a display synonym of an existing entity — same
# entity/hash, different label, no value change (distinct from MODIFY/OVERRIDE).
#   ALIAS ^"Ride" FOR ^"Drive"
# Ships in a setting's own extension file to re-skin vocabulary.
ALIAS_STATEMENT  <- 'ALIAS' _ CARET_REF _ 'FOR' _ HASH_ID? _ CARET_REF

# ─────────────────────────────────────────────────────────────
# 3c. v0.5 constructs (§§5c, 22-24). GUIDANCE_BLOCK is defined in §9b (BRIDGE)
# and reused here; the others are new. Semantics/coherence are the validator's job.
# ─────────────────────────────────────────────────────────────

# §5c — REFERENCES (renamed from MENTIONS): stand-off in-prose refs to other DEFs.
# Links a surface form in the enclosing DESCRIPTION to a target, which may (and per the
# strict rule SHOULD) carry the target's #hash. Targeting a mechanic's PARENT DEF
# (Light Wound -> ^"Wounds") is the norm when the mechanic is not its own DEF.
# MENTIONS is accepted as a deprecated alias.
REFERENCES_BLOCK    <- ('REFERENCES' / 'MENTIONS') _ '{' _ (REFERENCE_ENTRY _)* '}'
REFERENCE_ENTRY     <- STRING OCC_INDEX? _ '->' _ HASH_ID? _ CARET_REF
                     / COMMENT
OCC_INDEX           <- '@' [0-9]+

# Optional inverse mirror: what references THIS entry. Tool-derivable; when present,
# each entry must correspond to a real REFERENCES pointing here (validator gate).
REFERENCED_BY_BLOCK <- 'REFERENCED' _ 'BY' _ '{' _ (REFERENCED_BY_ENTRY _)* '}'
REFERENCED_BY_ENTRY <- (STRING _)? '<-' _ HASH_ID? _ CARET_REF
                     / COMMENT

# §23 — HOOKS: stand-off "a narrative situation has an otherwise-untracked mechanical
# consequence." FORMALITY declares how formal the hook is (author uses the highest
# level the source supports, no higher). WHEN is prose (any level) or a structured
# TRIGGER at higher levels; THEN names the mechanic(s) implicated.
HOOKS_BLOCK     <- 'HOOKS' _ '{' _ (HOOK_ENTRY _)* '}'
HOOK_ENTRY      <- 'HOOK' _ HASH_ID? _ '{' _ (HOOK_FIELD _)* '}'
                 / COMMENT
HOOK_FIELD      <- 'FORMALITY' _ FORMALITY_LEVEL
                 / 'WHEN' _ (STRING / GENERIC_VALUE)
                 / 'TRIGGER' _ GENERIC_VALUE
                 / 'THEN' _ '[' _ HOOK_REF (_ ',' _ HOOK_REF)* _ ']'
                 / COMMENT
FORMALITY_LEVEL <- 'PROSE' / 'TAGGED' / 'CONDITIONAL' / 'FORMAL'
HOOK_REF        <- HASH_ID? _ CARET_REF

# §24 — OPTIONAL: marks the enclosing DEF an optional/variant rule with a default
# posture and a scope (types/entities, or GLOBAL). User choices live in a .selections file.
OPTIONAL_BLOCK  <- 'OPTIONAL' _ '{' _ (OPTIONAL_FIELD _)* '}'
OPTIONAL_FIELD  <- 'DEFAULT' _ POSTURE
                 / 'SCOPE' _ '[' _ SCOPE_ITEM (_ ',' _ SCOPE_ITEM)* _ ']'
                 / TEXT_FIELD
                 / COMMENT
POSTURE         <- 'on' / 'off'
SCOPE_ITEM      <- 'GLOBAL' / (HASH_ID? _ CARET_REF)

# §24 — SELECTIONS: a `.selections` FILE (user's optional-rule choices for a corpus),
# a DSL container so it round-trips through the same parser/validator. Each SELECT
# names an OPTIONAL DEF's #hash and a posture; the validator checks the hash is a real
# OPTIONAL (see FILE, §1).
SELECTIONS_BLOCK <- 'SELECTIONS' _ STRING _ '{' _ (SELECTIONS_ENTRY _)* '}'
SELECTIONS_ENTRY <- METADATA
                  / 'FOR' _ STRING (_ 'VERSION' _ STRING)?
                  / 'SELECT' _ HASH_ID _ POSTURE (_ STRING)?
                  / COMMENT

# ═══════════════════════════════════════════════════════════
# 4. Properties Block
# ═══════════════════════════════════════════════════════════

PROPERTIES_BLOCK <- 'PROPERTIES' _ '{' _ (PROPERTY_DECL _)* '}'

PROPERTY_DECL   <- (CARET_REF / STRING) _ PROPERTY_TYPE

PROPERTY_TYPE   <- DEF_INLINE
                 / LIST_OF_TYPE
                 / LIST_LITERAL
                 / ENUM_TYPE
                 / STRING_TYPE
                 / INTEGER_TYPE
                 / BOOLEAN_TYPE

DEF_INLINE      <- 'DEF' _ '{' _ (PROPERTY_DECL _)* '}'

STRING_TYPE     <- 'STRING' (_ STRING)? (_ MODIFIER)*
INTEGER_TYPE    <- 'INTEGER' (_ INTEGER_LIT)? (_ MODIFIER)*
BOOLEAN_TYPE    <- 'BOOLEAN' (_ MODIFIER)*
ENUM_TYPE       <- 'ENUM' _ BRACKET_LIST
LIST_OF_TYPE    <- 'LIST' _ 'OF' _ (CARET_REF / 'STRING') (_ BRACKET_LIST)?
LIST_LITERAL    <- 'LIST' _ BRACKET_LIST

MODIFIER        <- 'REQUIRED' / 'FIXED'
                 / 'DEFAULT' _ VALUE
                 / 'MIN' _ INTEGER_LIT
                 / 'MAX' _ INTEGER_LIT
                 / 'FIAT' _ STRING

# ═══════════════════════════════════════════════════════════
# 5. Bare Type Constraints (in DEF body, outside PROPERTIES)
# ═══════════════════════════════════════════════════════════

BARE_TYPE_CONSTRAINT <- BARE_ENUM / BARE_INTEGER / BARE_STRING / BARE_BOOLEAN

BARE_ENUM       <- 'ENUM' _ BRACKET_LIST
BARE_INTEGER    <- 'INTEGER' (_ INTEGER_LIT)? (_ MODIFIER)*
BARE_STRING     <- 'STRING' (_ STRING)? (_ MODIFIER)*
BARE_BOOLEAN    <- 'BOOLEAN' (_ MODIFIER)*

# ═══════════════════════════════════════════════════════════
# 6. Inheritance and Scope
# ═══════════════════════════════════════════════════════════

EXTENDS_DECL    <- 'EXTENDS' _ HASH_ID? _ CARET_REF

APPLIES_TO_CLAUSE <- 'APPLIES' _ 'TO' _ '[' _ CARET_REF_LIST _ ']'

CARET_REF_LIST  <- CARET_REF (_ ',' _ CARET_REF)*

# FIAT: element-level intentional-exception marker; cascades over the DEF subtree.
# The reason STRING is required. (Property-level FIAT is a MODIFIER, section 4.)
FIAT_STATEMENT  <- 'FIAT' _ STRING

# ═══════════════════════════════════════════════════════════
# 7. Rules Block
# ═══════════════════════════════════════════════════════════

RULES_BLOCK     <- 'RULES' _ '{' _ (RULE_ENTRY _)* '}'

RULE_ENTRY      <- HASH_ID _ RULE_BODY
                 / COMMENT

# Rule body: either a colon-separated structured rule or a bare label
RULE_BODY       <- ':' _ RULE_CONTENT
                 / RULE_LABEL

# Structured rule: WHEN [...] THEN ... or MODIFY: ...
RULE_CONTENT    <- 'WHEN' _ '[' RULE_TEXT_INNER ']' _ 'THEN' _ RULE_TEXT
                 / 'MODIFY' ':' _ RULE_TEXT
                 / RULE_TEXT

# Bare label (no colon): identifier-style rule name
RULE_LABEL      <- [a-z_] [a-zA-Z0-9_]*

# Rule text consumes everything to end of line
RULE_TEXT       <- (!EOL .)*
RULE_TEXT_INNER <- (!']' .)*

# ═══════════════════════════════════════════════════════════
# 8. Modification System (Extensions)
# ═══════════════════════════════════════════════════════════

# Both spellings of MODIFY are legal and equivalent (spec S13); the prefix form is
# the one the spec's own examples use, the postfix form is what the vtm5e errata uses.
MODIFY_STATEMENT   <- 'MODIFY' _ HASH_ID? _ (CARET_REF / STRING) _ '{' _ MODIFY_BODY _ '}'
                    / (CARET_REF / STRING) _ 'MODIFY' _ '{' _ MODIFY_BODY _ '}'

# OVERRIDE with a block replaces a definition; the bare form is a statement inside a
# DEF body naming the definition this one supersedes. Either way the target is a
# reference and must resolve.
OVERRIDE_STATEMENT <- 'OVERRIDE' _ HASH_ID? _ (CARET_REF / STRING) _ '{' _ BODY _ '}'
                    / 'OVERRIDE' _ HASH_ID? _ (CARET_REF / STRING)
ADD_STATEMENT      <- 'ADD' _ DEF_BLOCK

# PROPERTIES inside a MODIFY INTRODUCES properties the target lacks; SET may only
# change one it already declares (spec S13, "Changing vs. introducing a property").
MODIFY_BODY     <- (MODIFY_ENTRY _)*
MODIFY_ENTRY    <- SET_ENTRY / ADD_TO_ENTRY / REMOVE_FROM_ENTRY
                 / PROPERTIES_BLOCK / RULES_BLOCK / COMMENT

# A SET may restate the whole type (`SET ^"Magnitude" ENUM [...]`) or just adjust a
# constraint on it (`SET ^"Starting Honor" DEFAULT 45`, as in the spec's own example).
SET_ENTRY       <- 'SET' _ CARET_REF _ (PROPERTY_TYPE / (MODIFIER _)+)
ADD_TO_ENTRY    <- 'ADD_TO' _ CARET_REF _ VALUE
REMOVE_FROM_ENTRY <- 'REMOVE_FROM' _ CARET_REF _ VALUE

# ═══════════════════════════════════════════════════════════
# 9. System-Defined Sub-Blocks (Generic)
#
# The base spec does not prescribe system keywords. Any UPPERCASE
# identifier followed by { }, [ ], or a value is a valid sub-block.
# This catch-all rule enables system vocabulary.
# ═══════════════════════════════════════════════════════════

GENERIC_BLOCK   <- UPPER_IDENT _ GENERIC_LABEL? _ GENERIC_VALUE

GENERIC_LABEL   <- CARET_REF / STRING / HASH_ID / INTEGER_LIT

GENERIC_VALUE   <- '{' _ GENERIC_BODY _ '}'
                 / BRACKET_LIST
                 / STRING
                 / INTEGER_LIT
                 / BOOLEAN_LIT

GENERIC_BODY    <- (GENERIC_BODY_ENTRY _)*

GENERIC_BODY_ENTRY <- DEF_BLOCK
                    / PROPERTIES_BLOCK
                    / RULES_BLOCK
                    / GENERIC_BLOCK
                    / NUMBERED_ENTRY
                    / LABELED_ENTRY
                    / CARET_ENTRY
                    / HASH_ENTRY
                    / INLINE_VALUE
                    / COMMENT

# Entries within generic blocks:
#   1 "text"                  (numbered entry)
#   KEYWORD "text"            (labeled entry)
#   ^"Name" "text"            (caret-labeled entry)
#   ^"Name" [tag]             (caret with bracket tag)
#   ^"Name" DEF { }           (nested def)
#   #hash: text               (hash-labeled, already covered by HASH_ENTRY)

NUMBERED_ENTRY  <- INTEGER_LIT _ (STRING / CARET_REF / GENERIC_BLOCK)

LABELED_ENTRY   <- UPPER_IDENT _ (STRING / CARET_REF / INTEGER_LIT / BRACKET_LIST / GENERIC_BLOCK)

CARET_ENTRY     <- CARET_REF _ (STRING / BRACKET_LIST / DEF_INLINE_BLOCK / GENERIC_BLOCK)?

HASH_ENTRY      <- HASH_ID _ (CARET_REF _ (STRING / BRACKET_LIST)?)?

DEF_INLINE_BLOCK <- 'DEF' _ '{' _ BODY _ '}'

# ═══════════════════════════════════════════════════════════
# 9b. BRIDGE — cross-edition conversion (v0.4, §21)
#
# The only container with TWO dependency lineages. ORIGIN/DESTINATION are
# mandatory and the direction is load-bearing (a bridge is not reversible by
# inspection). Every reference is side-qualified — by the enclosing slot
# keyword or by an inline ORIGIN/DESTINATION qualifier; the side is never
# inferred. A referent is TYPED (caret ref, gated against that side's corpus
# by the validator) or UNTYPED (plain string, for a thing the corpus has no
# DEF for). Two-corpus coherence is the validator's job, not this grammar's.
# ═══════════════════════════════════════════════════════════

BRIDGE_BLOCK    <- 'BRIDGE' _ STRING _ '{' _ BRIDGE_BODY _ '}'

BRIDGE_BODY     <- (BRIDGE_ENTRY _)*

BRIDGE_ENTRY    <- METADATA
                 / SIDE_DECL
                 / DISPOSITIONS_BLOCK
                 / ALIASES_BLOCK
                 / CONVERSION_BLOCK
                 / GUIDANCE_BLOCK
                 / COMMENT

# A side names an EDITION ID (the system id its corpus lives under, §19).
# EXTERNAL marks a side with no titterpig corpus; the reason is REQUIRED.
SIDE_DECL       <- SIDE_KW _ STRING (_ 'VERSION' _ STRING)? (_ 'EXTERNAL' _ STRING)?
SIDE_KW         <- 'ORIGIN' / 'DESTINATION'

# The document's own change-tag vocabulary, as ordinary DEFs so that every
# DISPOSITION reference resolves through normal coherence.
DISPOSITIONS_BLOCK <- 'DISPOSITIONS' _ '{' _ (DEF_BLOCK _)* '}'

# Names the DOCUMENT uses that the edition it describes does not (a publisher
# typo, an inconsistent printing). §5b's ALIAS with a side qualifier: same
# entity, no value change. The alias name then resolves on that side, so units
# keep the document's own vocabulary while the alias records what it denotes.
#   ALIAS ^"Contract Patron" FOR DESTINATION ^"Level 9: Contact Patron"
ALIASES_BLOCK   <- 'ALIASES' _ '{' _ (BRIDGE_ALIAS _)* '}'
BRIDGE_ALIAS    <- 'ALIAS' _ CARET_REF _ 'FOR' _ SIDED_REF
                 / COMMENT

# ── Conversion rules ──────────────────────────────────────────
CONVERSION_BLOCK <- 'CONVERSION' _ '{' _ (CONVERSION_UNIT _)* '}'
CONVERSION_UNIT  <- MAP_UNIT / REMAINDER_UNIT / PROCEDURE_UNIT / COMMENT

MAP_UNIT        <- 'MAP' _ HASH_ID? _ '{' _ (MAP_FIELD _)* '}'
MAP_FIELD       <- SIDE_KW _ REFERENT_SET        # slot supplies the side
                 / 'SCOPE' _ SIDED_REF
                 / 'ASPECT' _ STRING
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

# A bulk disposition over every member of SCOPE that no MAP names.
# EXHAUSTIVE false records a hedging source ("Most magic items not listed…").
REMAINDER_UNIT  <- 'REMAINDER' _ HASH_ID? _ '{' _ (REMAINDER_FIELD _)* '}'
REMAINDER_FIELD <- 'SCOPE' _ SIDED_REF
                 / 'EXHAUSTIVE' _ BOOLEAN_LIT
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

# Converts the VALUES on a character sheet (MAP corresponds ENTITIES).
PROCEDURE_UNIT  <- 'PROCEDURE' _ HASH_ID? _ '{' _ (PROCEDURE_FIELD _)* '}'
PROCEDURE_FIELD <- 'SUBJECT' _ SIDED_REF
                 / 'ASPECT' _ STRING
                 / CONVERT_STMT
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

CONVERT_STMT    <- 'CONVERT' _ SIDED_REF _ CONVERT_OP (_ 'INTO' _ SIDED_REF)?

# Closed operation vocabulary — deliberately NOT an expression language
# (the DSL guarantees a knowledge base, not a rules engine, §20).
CONVERT_OP      <- 'UNCHANGED'
                 / 'SCALE' _ INTEGER_LIT (_ 'OVER' _ INTEGER_LIT)?
                 / 'RESTATE'
                 / 'MANUAL' _ STRING

# ── Guidance ──────────────────────────────────────────────────
GUIDANCE_BLOCK  <- 'GUIDANCE' _ '{' _ (GUIDANCE_ENTRY _)* '}'

# The ENTRY caret is a LOCAL LABEL naming the passage, not a reference.
GUIDANCE_ENTRY  <- 'ENTRY' _ CARET_REF _ HASH_ID? _ '{' _ (GUIDANCE_FIELD _)* '}'
                 / COMMENT
# CONCERNS refs are SIDED_REF in a .bridge, or a (hash-qualified) caret in a .ttrpg
# (v0.5 generalization). DISPOSITION only occurs in a .bridge.
GUIDANCE_FIELD  <- 'CONCERNS' _ '[' _ GUIDANCE_REF (_ ',' _ GUIDANCE_REF)* _ ']'
                 / 'TOPICS' _ BRACKET_LIST
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT
GUIDANCE_REF    <- SIDED_REF / (HASH_ID? _ CARET_REF)

# ── Shared bridge pieces ──────────────────────────────────────
# A disposition is a SET, not a single value: documents compose tags
# ("Magic Action [New Name, Revised Rule]").
DISPOSITION_FIELD <- 'DISPOSITION' _ '[' _ CARET_REF (_ ',' _ CARET_REF)* _ ']'

TEXT_FIELD      <- 'TEXT' _ STRING

# Inside an ORIGIN/DESTINATION slot the side is already fixed, so referents
# are bare; SIDED_REF is for slots that could mean either side.
REFERENT_SET    <- REFERENT / '[' _ REFERENT (_ ',' _ REFERENT)* _ ']'
REFERENT        <- CARET_REF / STRING
SIDED_REF       <- SIDE_KW _ REFERENT

# ═══════════════════════════════════════════════════════════
# 10. Values and Literals
# ═══════════════════════════════════════════════════════════

VALUE           <- CHOICE_VALUE / STRING / INTEGER_LIT / BOOLEAN_LIT / CARET_REF / HASH_ID / BRACKET_LIST

INLINE_VALUE    <- STRING / CARET_REF

BRACKET_LIST    <- '[' _ BRACKET_ITEM (_ ',' _ BRACKET_ITEM)* _ ']'
BRACKET_ITEM    <- CHOICE_VALUE / CARET_REF / HASH_ID / STRING / INTEGER_LIT / BOOLEAN_LIT

# CHOICE — a structured "pick from these" value (v0.4, DECISION-6). Options are
# specific entities, verbatim strings (the completeness escape hatch), or
# quantified typed slots ("N OF <type> WHERE {field value ...}"). Optional
# PICK n sets how many options are taken (default 1).
#   CHOICE [ ^"Demonic Might", ^"Demonic Powers" ]
#   CHOICE [ 1 OF ^"Virtue" WHERE { ^"Size" "Major", ^"Category" "Supernatural" },
#            3 OF ^"Virtue" WHERE { ^"Size" "Minor", ^"Category" "Supernatural" } ]
CHOICE_VALUE    <- 'CHOICE' (_ 'PICK' _ INTEGER_LIT)? _ '[' _ CHOICE_OPTION (_ ',' _ CHOICE_OPTION)* _ ']'
CHOICE_OPTION   <- CHOICE_SLOT / CARET_REF / STRING
CHOICE_SLOT     <- INTEGER_LIT _ 'OF' _ CARET_REF (_ 'WHERE' _ '{' _ (WHERE_PAIR _)* '}')?
WHERE_PAIR      <- CARET_REF _ (STRING / INTEGER_LIT)

# ═══════════════════════════════════════════════════════════
# 11. Terminals
# ═══════════════════════════════════════════════════════════

# String: double-quoted, with escape sequences
STRING          <- TRIPLE_QUOTED / SINGLE_QUOTED
TRIPLE_QUOTED   <- '"""' (!'"""' .)* '"""'
SINGLE_QUOTED   <- '"' STRING_CHAR* '"'
STRING_CHAR     <- '\\' ESCAPE_CHAR / !'"' .
ESCAPE_CHAR     <- ["\\/nrt] / 'u' HEX HEX HEX HEX
HEX             <- [0-9a-fA-F]

# Integer: optional sign, digits
INTEGER_LIT     <- '-'? [0-9]+

# Boolean
BOOLEAN_LIT     <- 'true' / 'false'

# Caret reference: ^"Name", optionally with a parameter binding (DECISION-6).
# A bound ref fills a parameterized DEF's slots: ^"Puissant"(^"Single Weapon"),
# ^"Great"(^"Stamina"), ^"Area Lore"("Normandy"). Arguments bind positionally
# or by name (^"subject" = ^"Single Weapon"); each is a caret ref (an entity of
# the declared parameter type) or a string (a free-text slot). The derived
# display name ("Puissant Single Weapon") is rendered by consumers, not stored.
CARET_REF       <- '^' '"' (!'"' .)* '"' PARAM_BINDING?
PARAM_BINDING   <- _ '(' _ PARAM_ARG (_ ',' _ PARAM_ARG)* _ ')'
PARAM_ARG       <- (CARET_REF _ '=' _)? (CARET_REF / STRING)

# Hash ID: # followed by alphanumeric (no space after #)
# Distinguished from comments by: # + alphanum = hash ID, # + space = comment
HASH_ID         <- '#' [a-zA-Z0-9] [a-zA-Z0-9_]*

# Uppercase identifier (for system-defined keywords and generic blocks)
UPPER_IDENT     <- [A-Z] [A-Z0-9_]*
                   !{RESERVED_WORD}

# Note: UPPER_IDENT must not match reserved words when used as generic blocks.
# Reserved words are handled by their own rules with higher priority.

# ═══════════════════════════════════════════════════════════
# 12. Comments
# ═══════════════════════════════════════════════════════════

COMMENT         <- LINE_COMMENT / SLASH_COMMENT
LINE_COMMENT    <- '#' (' ' / &EOL) (!EOL .)*
SLASH_COMMENT   <- '//' (!EOL .)*

# ═══════════════════════════════════════════════════════════
# 13. Whitespace and Terminals
# ═══════════════════════════════════════════════════════════

_               <- (WHITESPACE / COMMENT)*
WHITESPACE      <- [ \t\r\n]+
EOL             <- '\r\n' / '\n' / '\r'
EOF             <- !.

# ═══════════════════════════════════════════════════════════
# Appendix: Reserved Words
# ═══════════════════════════════════════════════════════════
#
# These keywords are matched by dedicated rules and take priority
# over UPPER_IDENT / GENERIC_BLOCK:
#
# File-level:    BASE, EXTENSION, BRIDGE, EXTENDS, NAME, VERSION, SPEC_VERSION,
#                RELEASE_DATE, DEPENDS_ON
# Definition:    DEF, ACTOR, TEMPLATE, PROPERTIES, RULES
# Types:         STRING, INTEGER, BOOLEAN, ENUM, LIST, OF
# Modifiers:     REQUIRED, FIXED, DEFAULT, MIN, MAX, FIAT
# Scope:         APPLIES, TO
# Rule:          WHEN, THEN
# Modification:  OVERRIDE, ADD, MODIFY, SET, ADD_TO, REMOVE_FROM
# Parameterize:  PARAMETERS, OF (also a type keyword), ALIAS, FOR   (DECISION-6)
# Choice:        CHOICE, PICK, OF, WHERE                            (DECISION-6)
# References:    REFERENCES, MENTIONS (deprecated alias), REFERENCED, BY       (v0.5, §5c)
# Hooks:         HOOKS, HOOK, FORMALITY, WHEN, TRIGGER, THEN,
