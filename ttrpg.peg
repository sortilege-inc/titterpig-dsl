# ┌────────────────────────────────────────────────────────────────────┐
# │ Titterpig DSL — PEG Grammar, v0.5 (aligned to titterpig-dsl-spec.md).  │
# │ v0.4 additions: SPEC_VERSION metadata; FIAT (property-level modifier   │
# │ and element-level cascading statement). The hash-ID >=16-char rule   │
# │ and cross-file coherence are enforced by the validator, not here.    │
# └────────────────────────────────────────────────────────────────────┘
#
# Titterpig DSL — PEG Grammar (Bryan Ford notation)
# Formal syntax specification for .ttrpg files (v0.5)
# v0.5 additions (§3c): REFERENCES (renames MENTIONS) + REFERENCED BY + EMPHASIS; GUIDANCE in a
# DEF/module body (generalized from BRIDGE); HOOKS + FORMALITY; OPTIONAL; the
# SELECTIONS container for .selections files; the CODEX container for .codex files
# (§25 — the stand-off lore knowledge graph).
# v0.6 working draft: CHOOSE n replaces CHOICE / PICK / WHERE (§5b, DECISION-15), with
# DISTINCT / INDISTINCT and a WITH clause; BOOLEAN takes an inline value (§8); SET and
# TRANSFORM, a change to a value (§8, DECISION-16); REF, a reference to one entity (§8,
# DECISION-17); dice as DEFs with FACES, ROLL n OF, and NEXT between steps (§8, DECISION-18);
# EMPHASIS takes a kind (BOLD, ITALIC) and LABEL names a run-in label (§5c, DECISION-19);
# an embedded reference in a string may keep a different literal (§5c, DECISION-20);
# TABLE with AXIS, AT and COLUMNS (§5e, DECISION-21); FROM names its container's kind, and
# a block's name and hash may stand in either order (§16, DECISION-22).
# A SCENE's and a CONFLICT's TYPE is a reference to an entity the system defines (§16,
# DECISION-23); the validator checks it, since the containers are not yet rules here.
# A port's header names its source: ORIGIN "edition" <KIND> "id" (§19, DECISION-26).
# An .actor file is an EXTENSION_BLOCK of instance DEFs (§2, DECISION-28). FILE has no bare-DEF
# form, and the 670 older .actor files that open with a bare DEF do not match it.
#
# This grammar defines syntactically valid .ttrpg files. Semantic rules
# (hash uniqueness, EXTENDS resolution, type consistency) are enforced
# by the validator, not this grammar.
#
# Conventions:
#   UPPER_CASE  = rule names
#   'literal'   = terminal strings
#   [...]       = character class
#   !e          = not-predicate
#   &e          = and-predicate
#   e*          = zero or more
#   e+          = one or more
#   e?          = optional
#   e1 / e2     = ordered choice
#   (e)         = grouping

# ═══════════════════════════════════════════════════════════
# 1. File-Level Structure
# ═══════════════════════════════════════════════════════════

FILE            <- _ (BASE_BLOCK / EXTENSION_BLOCK / BRIDGE_BLOCK / SELECTIONS_BLOCK / CODEX_BLOCK) _ EOF

BASE_BLOCK      <- 'BASE' _ STRING _ '{' _ BODY _ '}'
EXTENSION_BLOCK <- 'EXTENSION' _ STRING _ EXTENDS_CLAUSE? _ '{' _ BODY _ '}'

EXTENDS_CLAUSE  <- 'EXTENDS' _ STRING

BODY            <- (BODY_ENTRY _)*

BODY_ENTRY      <- METADATA
                 / ALIAS_STATEMENT
                 / REPRINT_STATEMENT         # v0.5 addendum, §5b — unchanged reprint
                 / DEF_BLOCK
                 / PROPERTIES_BLOCK
                 / PARAMETERS_BLOCK
                 / RULES_BLOCK
                 / REFERENCES_BLOCK          # v0.5, §5c — renamed from MENTIONS
                 / REFERENCED_BY_BLOCK       # v0.5, §5c — optional inverse mirror
                 / EMPHASIS_BLOCK            # v0.5, §5c — emphasis with no referent
                 / LABEL_BLOCK               # v0.6, §5c — a run-in label (DECISION-19)
                 / TABLE_BLOCK               # v0.6, §5e — a table (DECISION-21)
                 / GUIDANCE_BLOCK            # v0.5, §22 — generalized from BRIDGE
                 / HOOKS_BLOCK               # v0.5, §23 — conditional emit hooks
                 / OPTIONAL_BLOCK            # v0.5, §24 — optional/variant rule marker
                 / APPLIES_TO_CLAUSE
                 / EXTENDS_DECL
                 / FIAT_STATEMENT
                 / BARE_TYPE_CONSTRAINT
                 / MODIFY_STATEMENT
                 / OVERRIDE_STATEMENT
                 / ADD_STATEMENT
                 / FACES_BLOCK               # v0.6, §8 — a die's faces
                 / STEP                      # v0.6, §8 — NEXT <statement>
                 / CHANGE                    # v0.6, §8 — <target> SET n / TRANSFORM …
                 / CHOOSE_KEYED              # v0.6, §5b — a CHOOSE in place of a name
                 / CHOOSE_VALUE              # v0.6, §5b — a CHOOSE alone in a block
                 / GENERIC_BLOCK
                 / INLINE_VALUE
                 / COMMENT

# ═══════════════════════════════════════════════════════════
# 2. Metadata
# ═══════════════════════════════════════════════════════════

METADATA        <- NAME_DECL / SPEC_VERSION_DECL / VERSION_DECL / RELEASE_DATE_DECL / DEPENDS_ON_DECL
                 / ORIGIN_DECL

NAME_DECL       <- 'NAME' _ STRING
SPEC_VERSION_DECL <- 'SPEC_VERSION' _ STRING
VERSION_DECL    <- 'VERSION' _ STRING
RELEASE_DATE_DECL <- 'RELEASE_DATE' _ STRING
DEPENDS_ON_DECL <- 'DEPENDS_ON' _ STRING (_ 'VERSION' _ STRING)?

# v0.6 (DECISION-26, §19): a port names the edition and the container it was made from.
#   ORIGIN "arm5e" EXTENSION "ArM5_Grogs_Abilities"
# One per file, in the header. A port keeps the hashes of that container.
ORIGIN_DECL     <- 'ORIGIN' _ STRING _ PORT_KIND _ STRING
PORT_KIND       <- CONTAINER_KIND / 'CAMPAIGN'

# ═══════════════════════════════════════════════════════════
# 3. Definitions (DEF)
# ═══════════════════════════════════════════════════════════

# All DEF forms:
#   ^"Name" DEF { ... }
#   #hash ^"Name" DEF { ... }
#   #hash ACTOR "Name" DEF { ... }
#   #hash TEMPLATE "Name" DEF { ... }
#   #hash "Name" DEF { ... }
#   ^"Name" DEF { ... }          (no hash)
#   "Name" DEF { ... }           (rare, no caret)

DEF_BLOCK       <- HASH_ID? _ ACTOR_KW? _ DEF_NAME _ 'DEF' _ '{' _ BODY _ '}'

ACTOR_KW        <- 'ACTOR' / 'TEMPLATE'
DEF_NAME        <- CARET_REF / STRING

# ─────────────────────────────────────────────────────────────
# 3b. Parameterized definitions & aliases (v0.4, DECISION-6)
# ─────────────────────────────────────────────────────────────

# A DEF may declare typed parameter slots that bound references fill.
#   ^"Puissant" DEF { PARAMETERS { ^"subject" OF ^"Ability" } ... }
# A parameter domain is a caret type (bound value must be an entity of that
# type) or STRING (free text, e.g. a place name).
PARAMETERS_BLOCK <- 'PARAMETERS' _ '{' _ (PARAM_DECL _)* '}'
# A parameter's domain is a caret type (bound value is an entity of that type),
# STRING (free text), or a bracket list (an enum of literal allowed values,
# e.g. selecting a Major-or-Minor virtue's severity: ^"Size" OF ["Major","Minor"]).
PARAM_DECL       <- CARET_REF _ 'OF' _ (CARET_REF / 'STRING' / BRACKET_LIST)

# ALIAS declares one name a display synonym of an existing entity — same
# entity/hash, different label, no value change (distinct from MODIFY/OVERRIDE).
#   ALIAS ^"Ride" FOR ^"Drive"
# Ships in a setting's own extension file to re-skin vocabulary.
ALIAS_STATEMENT  <- 'ALIAS' _ CARET_REF _ 'FOR' _ HASH_ID? _ CARET_REF

# REPRINT records that this book prints an existing entity whose text the target holds --
# unchanged, or in an older wording the target supersedes (v0.5 addendum, DECISION-14). It
# declares nothing: the target must resolve and SHOULD carry its #hash.
#   REPRINT #tZhJv5oWt4DoTU8mwaNHNmPz ^"Folk Magic"
REPRINT_STATEMENT <- 'REPRINT' _ HASH_ID? _ CARET_REF

# ─────────────────────────────────────────────────────────────
# 3c. v0.5 constructs (§§5c, 22-24). GUIDANCE_BLOCK is defined in §9b (BRIDGE)
# and reused here; the others are new. Semantics/coherence are the validator's job.
# ─────────────────────────────────────────────────────────────

# §5c — REFERENCES (renamed from MENTIONS): stand-off in-prose refs to other DEFs.
# Links a surface form in the enclosing DESCRIPTION to a target, which may (and per the
# strict rule SHOULD) carry the target's #hash. Targeting a mechanic's PARENT DEF
# (Light Wound -> ^"Wounds") is the norm when the mechanic is not its own DEF.
# MENTIONS is accepted as a deprecated alias.
REFERENCES_BLOCK    <- ('REFERENCES' / 'MENTIONS') _ '{' _ (REFERENCE_ENTRY _)* '}'
REFERENCE_ENTRY     <- STRING OCC_INDEX? _ '->' _ HASH_ID? _ CARET_REF
                     / COMMENT
OCC_INDEX           <- '@' [0-9]+

# §5c — EMPHASIS: stand-off typographic emphasis with NO referent *(v0.5)*.
# The companion to REFERENCES, and settled the same way: a span the source sets
# apart is recorded BESIDE the verbatim text, never as markup inside it
# (DECISION-7). REFERENCES is for a span that names another DEF; EMPHASIS is for
# one that names nothing -- Root prints `When you **travel from clearing to
# clearing through the forest**, the band collectively decides...`, where the
# display face marks where the triggering fiction ends and the mechanics begin.
# No target, so no hash and no resolution: the only coherence rule is the one
# REFERENCES already has, that the surface form appear in the DEF's own prose.
# v0.6 (DECISION-19): the block may say how the span is set -- BOLD, ITALIC, or both in
# either order, each at most once. With no kind the span is marked and the kind unrecorded.
EMPHASIS_BLOCK      <- 'EMPHASIS' _ EMPHASIS_KIND? _ '{' _ (EMPHASIS_ENTRY _)* '}'
EMPHASIS_KIND       <- 'BOLD' _ 'ITALIC' / 'ITALIC' _ 'BOLD' / 'BOLD' / 'ITALIC'
EMPHASIS_ENTRY      <- STRING OCC_INDEX?
                     / COMMENT

# §5c — LABEL: a run-in label, beside the text *(v0.6, DECISION-19)*.
# `Prot: The bonus the armor grants...` keeps its label in the string as printed; the
# LABEL block names it. The optional whole number is the label's depth (1 when absent):
# a depth-2 label sits under the depth-1 label before it. Same coherence rule as
# EMPHASIS: the surface form appears in the DEF's own prose.
LABEL_BLOCK         <- 'LABEL' _ LABEL_DEPTH? _ '{' _ (EMPHASIS_ENTRY _)* '}'
LABEL_DEPTH         <- [1-9] [0-9]*

# Optional inverse mirror: what references THIS entry. Tool-derivable; when present,
# each entry must correspond to a real REFERENCES pointing here (validator gate).
REFERENCED_BY_BLOCK <- 'REFERENCED' _ 'BY' _ '{' _ (REFERENCED_BY_ENTRY _)* '}'
REFERENCED_BY_ENTRY <- (STRING _)? '<-' _ HASH_ID? _ CARET_REF
                     / COMMENT

# §23 — HOOKS: stand-off "a narrative situation has an otherwise-untracked mechanical
# consequence." FORMALITY declares how formal the hook is (author uses the highest
# level the source supports, no higher). WHEN is prose (any level) or a structured
# TRIGGER at higher levels; THEN names the mechanic(s) implicated.
HOOKS_BLOCK     <- 'HOOKS' _ '{' _ (HOOK_ENTRY _)* '}'
HOOK_ENTRY      <- 'HOOK' _ HASH_ID? _ '{' _ (HOOK_FIELD _)* '}'
                 / COMMENT
HOOK_FIELD      <- 'FORMALITY' _ FORMALITY_LEVEL
                 / 'WHEN' _ (STRING / GENERIC_VALUE)
                 / 'TRIGGER' _ GENERIC_VALUE
                 / 'THEN' _ '[' _ HOOK_REF (_ ',' _ HOOK_REF)* _ ']'
                 / COMMENT
FORMALITY_LEVEL <- 'PROSE' / 'TAGGED' / 'CONDITIONAL' / 'FORMAL'
HOOK_REF        <- HASH_ID? _ CARET_REF

# §24 — OPTIONAL: marks the enclosing DEF an optional/variant rule with a default
# posture and a scope (types/entities, or GLOBAL). User choices live in a .selections file.
OPTIONAL_BLOCK  <- 'OPTIONAL' _ '{' _ (OPTIONAL_FIELD _)* '}'
OPTIONAL_FIELD  <- 'DEFAULT' _ POSTURE
                 / 'SCOPE' _ '[' _ SCOPE_ITEM (_ ',' _ SCOPE_ITEM)* _ ']'
                 / TEXT_FIELD
                 / COMMENT
POSTURE         <- 'on' / 'off'
SCOPE_ITEM      <- 'GLOBAL' / (HASH_ID? _ CARET_REF)

# §24 — SELECTIONS: a `.selections` FILE (user's optional-rule choices for a corpus),
# a DSL container so it round-trips through the same parser/validator. Each SELECT
# names an OPTIONAL DEF's #hash and a posture; the validator checks the hash is a real
# OPTIONAL (see FILE, §1).
SELECTIONS_BLOCK <- 'SELECTIONS' _ STRING _ '{' _ (SELECTIONS_ENTRY _)* '}'
SELECTIONS_ENTRY <- METADATA
                  / 'FOR' _ STRING (_ 'VERSION' _ STRING)?
                  / 'SELECT' _ HASH_ID _ POSTURE (_ STRING)?
                  / COMMENT

# §25 — CODEX: a `.codex` FILE — the stand-off lore knowledge graph. A CATEGORIES
# taxonomy, a declared RELATIONS predicate vocabulary, and ENTITY nodes with typed
# edges. Category/entity NAMES join the corpus namespace; predicates must be
# declared; the .lore prose is never touched (SOURCE/AT point INTO it). Coherence
# (IS/object resolution, undeclared-predicate, DOMAIN/RANGE, slug match) is in the
# validator (see FILE, §1).
CODEX_BLOCK      <- 'CODEX' _ STRING _ '{' _ (CODEX_ENTRY _)* '}'
CODEX_ENTRY      <- METADATA
                  / 'FOR' _ 'EDITION' _ STRING
                  / SOURCES_BLOCK
                  / CATEGORIES_BLOCK
                  / RELATIONS_BLOCK
                  / ENTITY_BLOCK
                  / COMMENT

# SOURCES — the derived-provenance manifest: which books/files, at which
# versions, this graph is derived from. Header-level (a codex is derived, so it
# records its inputs). Each entry is a source label (a book name or a .lore path)
# with an optional VERSION and an optional AT path when the label is a book and
# the path pins the specific prose file. Repeatable.
SOURCES_BLOCK    <- 'SOURCES' _ '{' _ (SOURCE_ENTRY _)* '}'
SOURCE_ENTRY     <- STRING (_ 'VERSION' _ STRING)? (_ 'AT' _ STRING)? / COMMENT

CATEGORIES_BLOCK <- 'CATEGORIES' _ '{' _ (CATEGORY_DECL _)* '}'
CATEGORY_DECL    <- HASH_ID? _ CARET_REF _ 'DEF' _ '{' _ (('EXTENDS' _ HASH_ID? _ CARET_REF) / COMMENT / _)* '}'

RELATIONS_BLOCK  <- 'RELATIONS' _ '{' _ (RELATION_DECL _)* '}'
RELATION_DECL    <- CARET_REF _ '{' _ (RELATION_QUAL _)* '}'
RELATION_QUAL    <- 'INVERSE' _ CARET_REF
                  / 'DOMAIN' _ CARET_REF
                  / 'RANGE' _ CARET_REF
                  / 'SYMMETRIC'
                  / 'TRANSITIVE'
                  / COMMENT

ENTITY_BLOCK     <- 'ENTITY' _ HASH_ID? _ CARET_REF _ '{' _ (ENTITY_ENTRY _)* '}'
ENTITY_ENTRY     <- 'IS' _ CARET_REF+
                  / 'SOURCE' _ STRING (_ 'AT' _ STRING)?
                  / RELATIONSHIPS_BLOCK
                  / COMMENT
RELATIONSHIPS_BLOCK <- 'RELATIONSHIPS' _ '{' _ (EDGE_DECL _)* '}'
# The '->' arrow is cosmetic (non-token); an edge is predicate-caret + object-caret.
EDGE_DECL        <- CARET_REF _ ARROW? _ CARET_REF (_ 'FROM' _ STRING)?
ARROW            <- '->'

# ═══════════════════════════════════════════════════════════
# 4. Properties Block
# ═══════════════════════════════════════════════════════════

PROPERTIES_BLOCK <- 'PROPERTIES' _ '{' _ ((STEP / CHANGE / REF_DECL / PROPERTY_DECL) _)* '}'

PROPERTY_DECL   <- (CARET_REF / STRING) _ PROPERTY_TYPE

PROPERTY_TYPE   <- DEF_INLINE
                 / CHOOSE_VALUE              # v0.6, §5b — ^"Background" CHOOSE 1 [ … ]
                 / REF_TYPE                  # v0.6, §8 — ^"Clan" REF #hash ^"Crab"
                 / ROLL_TYPE                 # v0.6, §8 — ^"Roll" ROLL 4 OF #hash ^"d8"
                 / LIST_OF_TYPE
                 / LIST_LITERAL
                 / ENUM_TYPE
                 / STRING_TYPE
                 / INTEGER_TYPE
                 / BOOLEAN_TYPE

DEF_INLINE      <- 'DEF' _ '{' _ ((STEP / CHANGE / CHOOSE_KEYED / REF_DECL / PROPERTY_DECL) _)* '}'

STRING_TYPE     <- 'STRING' (_ STRING)? (_ MODIFIER)*
INTEGER_TYPE    <- 'INTEGER' (_ INTEGER_LIT)? (_ MODIFIER)*
BOOLEAN_TYPE    <- 'BOOLEAN' (_ BOOLEAN_LIT)? (_ MODIFIER)*
ENUM_TYPE       <- 'ENUM' _ BRACKET_LIST
LIST_OF_TYPE    <- 'LIST' _ 'OF' _ (CARET_REF / 'STRING') (_ BRACKET_LIST)?
LIST_LITERAL    <- 'LIST' _ BRACKET_LIST

# REF — a reference to one entity (v0.6, DECISION-17). `REF OF ^"Type"` declares the
# property; `REF ^"Entity"` gives its value; both may be written. A reference that is
# followed by a property type, DEF, CHOOSE, SET or TRANSFORM belongs to the next
# statement and is not this property's value.
#   REF OF #hash ^"Clan" REQUIRED                  on the type; the property is named ^"Clan"
#   ^"Patron" REF OF #hash ^"Virtue"               on the type, with a name of its own (a name
#                                                  may always be written, even the type's)
#   ^"Clan" REF #hash ^"Crab"                      on an instance
REF_TYPE        <- 'REF' (_ 'OF' _ HASHED_REF)? (_ REF_TARGET)? (_ MODIFIER)*
# The declaration with no name of its own: the property takes the type's name.
REF_DECL        <- 'REF' _ 'OF' _ HASHED_REF (_ REF_TARGET)? (_ MODIFIER)*
REF_TARGET      <- HASHED_REF !(_ NEXT_STATEMENT_KW)
NEXT_STATEMENT_KW <- 'STRING' / 'INTEGER' / 'BOOLEAN' / 'ENUM' / 'LIST' / 'REF' / 'ROLL' / 'DEF'
                   / 'CHOOSE' / 'SET' / 'TRANSFORM' / 'MODIFY'

# Dice and rolls (v0.6, DECISION-18).
# A die is a DEF that EXTENDS ^"Die" and lists its faces. A face is a number, or a range
# standing for one face each; it may be followed by what it shows (a string or a
# reference) and by WEIGHT n. Each face has a weight of 1 unless it says otherwise.
#   FACES { 1-8 }
#   FACES { 1 "Blank"  2 #hash ^"Opportunity"  3 WEIGHT 2 }
FACES_BLOCK     <- 'FACES' _ '{' _ (FACE _)* '}'
FACE            <- ROLL_KEY (_ (STRING / HASHED_REF))? (_ 'WEIGHT' _ INTEGER_LIT)?
# A roll of n dice. Where the faces are numbers its value is their sum. A TRANSFORM may
# follow it in the same statement and changes that value.
#   ^"Roll" ROLL 4 OF #hash ^"d8" TRANSFORM ADD 12
ROLL_TYPE       <- 'ROLL' _ INTEGER_LIT _ 'OF' _ HASHED_REF (_ TRANSFORM_CHANGE)*
# Statements in a block have no order. NEXT before a statement makes it a step that
# follows the statement above it. A chain runs forward only: no branch, no loop.
#   NEXT #hash ^"Hit Points" SET ^"Roll"
STEP            <- 'NEXT' _ (CHANGE / CHOOSE_KEYED / PROPERTY_DECL)

# §5e — TABLE: a table, as a primitive block in a DEF's body *(v0.6, DECISION-21)*.
# AXIS lines declare what the table is looked up by; AT gives the result at one coordinate
# per axis, in the order the axes are declared. A table of records has no cells: one axis
# OF a type, and COLUMNS naming that type's properties in printed order.
#   TABLE {
#       AXIS ^"Odds" OF #hash ^"Odds"
#       AXIS ^"Chaos Factor" 1-9
#       AT [ #hash ^"Certain", 1 ] { ^"Yes" INTEGER 50 }
#   }
#   TABLE { AXIS ^"Material" OF #hash ^"Armor"  COLUMNS [ ^"Prot", ^"Load" ] }
# That each AT gives one coordinate per axis, of a kind the axis takes, and that no two
# cells cover the same coordinates, is the validator's to check, not this grammar's.
TABLE_BLOCK     <- 'TABLE' _ '{' _ (AXIS_DECL _)+ ((AT_CELL _)+ / TABLE_COLUMNS _) '}'
AXIS_DECL       <- 'AXIS' _ (CARET_REF / STRING) _ AXIS_POINTS
AXIS_POINTS     <- 'OF' _ HASHED_REF
                 / INTEGER_LIT '-' INTEGER_LIT
                 / 'INTEGER'
                 / 'ROLL' _ INTEGER_LIT _ 'OF' _ HASHED_REF
                 / '[' _ AXIS_POINT (_ ',' _ AXIS_POINT)* _ ']'
AXIS_POINT      <- STRING / HASHED_REF
AT_CELL         <- 'AT' _ '[' _ COORDINATE (_ ',' _ COORDINATE)* _ ']' _ '{' _ BODY '}'
COORDINATE      <- 'ANY'
                 / 'MIN' _ INTEGER_LIT
                 / 'MAX' _ INTEGER_LIT
                 / INTEGER_LIT ('-' INTEGER_LIT)?
                 / HASHED_REF
                 / STRING
TABLE_COLUMNS   <- 'COLUMNS' _ '[' _ CARET_REF (_ ',' _ CARET_REF)* _ ']'

# A change to a value (v0.6, DECISION-16). The target is a reference to the thing changed,
# or a CHOOSE, in which case the change applies to each option chosen.
#   #hash ^"Glory"   SET 44
#   #hash ^"Command" TRANSFORM ADD 1
#   #hash ^"Speed"   TRANSFORM DIVIDE 2 ROUND DOWN MIN 1
#   #hash ^"TN"      TRANSFORM ADD #hash ^"School Rank"
#   #hash ^"Damage Die" TRANSFORM MANUAL "increase the die by one step"
#   CHOOSE 1 [ #hash ^"Earth", #hash ^"Fire" ] TRANSFORM ADD 1
# FOR REVIEW: SET is also the §13 directive inside a MODIFY body, written BEFORE its
# target (SET_ENTRY, section 8). Here it FOLLOWS its target. Position tells them apart.
CHANGE          <- CHANGE_TARGET _ (SET_CHANGE / TRANSFORM_CHANGE)
CHANGE_TARGET   <- CHOOSE_VALUE / HASHED_REF
SET_CHANGE      <- 'SET' _ AMOUNT
TRANSFORM_CHANGE <- 'TRANSFORM' _ ('MANUAL' _ STRING / METHOD _ AMOUNT (_ CHANGE_SUFFIX)*)
METHOD          <- 'ADD' / 'SUBTRACT' / 'MULTIPLY' / 'DIVIDE'
AMOUNT          <- INTEGER_LIT / REF_TARGET      # a reference that opens the next statement is not an amount
CHANGE_SUFFIX   <- 'ROUND' _ ('UP' / 'DOWN' / 'NEAREST')
                 / 'MIN' _ INTEGER_LIT
                 / 'MAX' _ INTEGER_LIT

MODIFIER        <- 'REQUIRED' / 'FIXED'
                 / 'DEFAULT' _ VALUE
                 / 'MIN' _ INTEGER_LIT
                 / 'MAX' _ INTEGER_LIT
                 / 'FIAT' _ STRING

# ═══════════════════════════════════════════════════════════
# 5. Bare Type Constraints (in DEF body, outside PROPERTIES)
# ═══════════════════════════════════════════════════════════

BARE_TYPE_CONSTRAINT <- BARE_ENUM / BARE_INTEGER / BARE_STRING / BARE_BOOLEAN

BARE_ENUM       <- 'ENUM' _ BRACKET_LIST
BARE_INTEGER    <- 'INTEGER' (_ INTEGER_LIT)? (_ MODIFIER)*
BARE_STRING     <- 'STRING' (_ STRING)? (_ MODIFIER)*
BARE_BOOLEAN    <- 'BOOLEAN' (_ BOOLEAN_LIT)? (_ MODIFIER)*

# ═══════════════════════════════════════════════════════════
# 6. Inheritance and Scope
# ═══════════════════════════════════════════════════════════

EXTENDS_DECL    <- 'EXTENDS' _ HASH_ID? _ CARET_REF

APPLIES_TO_CLAUSE <- 'APPLIES' _ 'TO' _ '[' _ CARET_REF_LIST _ ']'

CARET_REF_LIST  <- CARET_REF (_ ',' _ CARET_REF)*

# FIAT: element-level intentional-exception marker; cascades over the DEF subtree.
# The reason STRING is required. (Property-level FIAT is a MODIFIER, section 4.)
FIAT_STATEMENT  <- 'FIAT' _ STRING

# ═══════════════════════════════════════════════════════════
# 7. Rules Block
# ═══════════════════════════════════════════════════════════

RULES_BLOCK     <- 'RULES' _ '{' _ (RULE_ENTRY _)* '}'

RULE_ENTRY      <- HASH_ID _ RULE_BODY
                 / COMMENT

# Rule body: either a colon-separated structured rule or a bare label
RULE_BODY       <- ':' _ RULE_CONTENT
                 / RULE_LABEL

# Structured rule: WHEN [...] THEN ... or MODIFY: ...
RULE_CONTENT    <- 'WHEN' _ '[' RULE_TEXT_INNER ']' _ 'THEN' _ RULE_TEXT
                 / 'MODIFY' ':' _ RULE_TEXT
                 / RULE_TEXT

# Bare label (no colon): identifier-style rule name
RULE_LABEL      <- [a-z_] [a-zA-Z0-9_]*

# Rule text consumes everything to end of line
RULE_TEXT       <- (!EOL .)*
RULE_TEXT_INNER <- (!']' .)*

# ═══════════════════════════════════════════════════════════
# 8. Modification System (Extensions)
# ═══════════════════════════════════════════════════════════

# Both spellings of MODIFY are legal and equivalent (spec S13); the prefix form is
# the one the spec's own examples use, the postfix form is what the vtm5e errata uses.
MODIFY_STATEMENT   <- 'MODIFY' _ HASH_ID? _ (CARET_REF / STRING) _ '{' _ MODIFY_BODY _ '}'
                    / (CARET_REF / STRING) _ 'MODIFY' _ '{' _ MODIFY_BODY _ '}'

# OVERRIDE with a block replaces a definition; the bare form is a statement inside a
# DEF body naming the definition this one supersedes. Either way the target is a
# reference and must resolve.
OVERRIDE_STATEMENT <- 'OVERRIDE' _ HASH_ID? _ (CARET_REF / STRING) _ '{' _ BODY _ '}'
                    / 'OVERRIDE' _ HASH_ID? _ (CARET_REF / STRING)
ADD_STATEMENT      <- 'ADD' _ DEF_BLOCK

# PROPERTIES inside a MODIFY INTRODUCES properties the target lacks; SET may only
# change one it already declares (spec S13, "Changing vs. introducing a property").
MODIFY_BODY     <- (MODIFY_ENTRY _)*
MODIFY_ENTRY    <- SET_DESCRIPTION_ENTRY / SET_ENTRY / ADD_TO_ENTRY / REMOVE_FROM_ENTRY
                 / PROPERTIES_BLOCK / RULES_BLOCK / COMMENT

# A SET may restate the whole type (`SET ^"Magnitude" ENUM [...]`) or just adjust a
# constraint on it (`SET ^"Starting Honor" DEFAULT 45`, as in the spec's own example).
SET_ENTRY       <- 'SET' _ CARET_REF _ (PROPERTY_TYPE / (MODIFIER _)+)
# A variant printing replaces the target's whole DESCRIPTION, verbatim (v0.5 addendum, §13).
SET_DESCRIPTION_ENTRY <- 'SET' _ 'DESCRIPTION' _ STRING
ADD_TO_ENTRY    <- 'ADD_TO' _ CARET_REF _ VALUE
REMOVE_FROM_ENTRY <- 'REMOVE_FROM' _ CARET_REF _ VALUE

# ═══════════════════════════════════════════════════════════
# 9. System-Defined Sub-Blocks (Generic)
#
# The base spec does not prescribe system keywords. Any UPPERCASE
# identifier followed by { }, [ ], or a value is a valid sub-block.
# This catch-all rule enables system vocabulary.
# ═══════════════════════════════════════════════════════════

GENERIC_BLOCK   <- UPPER_IDENT _ GENERIC_LABEL? _ GENERIC_VALUE

# A named block gives its name and then its hash, by convention -- SCENE ^"Name" #hash { --
# and hash before name is also legal (v0.6, DECISION-22). Either may stand alone.
# The hash makes the block a target for any file; the name alone is a label inside the file
# that declares it (§20, DECISION-24).
GENERIC_LABEL   <- CARET_REF _ HASH_ID / HASH_ID _ CARET_REF
                 / CARET_REF / STRING / HASH_ID / INTEGER_LIT

# §16 — an import *(v0.6, DECISION-22)*. The line names the KIND of container, then its id,
# and is itself the declaration of that dependency. Each INCLUDE item is a reference (§5d).
#   FROM EXTENSION "L5R5e_Children_of_Five_Winds_GM" INCLUDE [ #hash ^"Miya Tetsua" ]
#   FROM ARC "ArcID"
# The containers themselves (SETTING, FRAME, ARC, CAMPAIGN) are not yet rules of this
# grammar; FILE lists only BASE, EXTENSION, BRIDGE, SELECTIONS and CODEX.
FROM_IMPORT     <- 'FROM' _ CONTAINER_KIND _ STRING (_ 'INCLUDE' _ '[' _ HASHED_REF (_ ',' _ HASHED_REF)* _ ']')?
CONTAINER_KIND  <- 'EXTENSION' / 'FRAME' / 'ARC' / 'SETTING' / 'BASE'

GENERIC_VALUE   <- '{' _ GENERIC_BODY _ '}'
                 / BRACKET_LIST
                 / STRING
                 / INTEGER_LIT
                 / BOOLEAN_LIT

GENERIC_BODY    <- (GENERIC_BODY_ENTRY _)*

GENERIC_BODY_ENTRY <- DEF_BLOCK
                    / STEP
                    / CHANGE
                    / CHOOSE_KEYED
                    / CHOOSE_VALUE
                    / PROPERTIES_BLOCK
                    / RULES_BLOCK
                    / GENERIC_BLOCK
                    / NUMBERED_ENTRY
                    / LABELED_ENTRY
                    / CARET_ENTRY
                    / HASH_ENTRY
                    / INLINE_VALUE
                    / COMMENT

# Entries within generic blocks:
#   1 "text"                  (numbered entry)
#   2-3 "text"                (roll-range entry — random tables)
#   1 ^"Name" DEF { }         (numbered nested def)
#   2-3 #hash ^"Name" DEF { } (roll-range nested def, anchored)
#   KEYWORD "text"            (labeled entry)
#   ^"Name" "text"            (caret-labeled entry)
#   ^"Name" [tag]             (caret with bracket tag)
#   ^"Name" DEF { }           (nested def)
#   #hash: text               (hash-labeled, already covered by HASH_ENTRY)

# A numbered entry may be keyed by a single roll or by a range of rolls, and
# may carry an anchor hash before its name. Random tables in several systems
# assign one result to a span of die results (a d10 table with six outcomes),
# so the key is a range rather than an integer; encoding that span as prose
# would put something a tool must read outside the structure.
NUMBERED_ENTRY  <- ROLL_KEY _ HASH_ID? _ (STRING / CARET_REF / GENERIC_BLOCK)

ROLL_KEY        <- ROLL_RANGE / INTEGER_LIT

ROLL_RANGE      <- INTEGER_LIT '-' INTEGER_LIT

LABELED_ENTRY   <- UPPER_IDENT _ (CHOOSE_VALUE / STRING / CARET_REF / INTEGER_LIT / BRACKET_LIST / GENERIC_BLOCK)

CARET_ENTRY     <- CARET_REF _ (STRING / BRACKET_LIST / DEF_INLINE_BLOCK / GENERIC_BLOCK)?

HASH_ENTRY      <- HASH_ID _ (CARET_REF _ (STRING / BRACKET_LIST)?)?

DEF_INLINE_BLOCK <- 'DEF' _ '{' _ BODY _ '}'

# ═══════════════════════════════════════════════════════════
# 9b. BRIDGE — cross-edition conversion (v0.4, §21)
#
# The only container with TWO dependency lineages. ORIGIN/DESTINATION are
# mandatory and the direction is load-bearing (a bridge is not reversible by
# inspection). Every reference is side-qualified — by the enclosing slot
# keyword or by an inline ORIGIN/DESTINATION qualifier; the side is never
# inferred. A referent is TYPED (caret ref, gated against that side's corpus
# by the validator) or UNTYPED (plain string, for a thing the corpus has no
# DEF for). Two-corpus coherence is the validator's job, not this grammar's.
# ═══════════════════════════════════════════════════════════

BRIDGE_BLOCK    <- 'BRIDGE' _ STRING _ '{' _ BRIDGE_BODY _ '}'

BRIDGE_BODY     <- (BRIDGE_ENTRY _)*

BRIDGE_ENTRY    <- METADATA
                 / SIDE_DECL
                 / DISPOSITIONS_BLOCK
                 / ALIASES_BLOCK
                 / CONVERSION_BLOCK
                 / GUIDANCE_BLOCK
                 / COMMENT

# A side names an EDITION ID (the system id its corpus lives under, §19).
# EXTERNAL marks a side with no titterpig corpus; the reason is REQUIRED.
SIDE_DECL       <- SIDE_KW _ STRING (_ 'VERSION' _ STRING)? (_ 'EXTERNAL' _ STRING)?
SIDE_KW         <- 'ORIGIN' / 'DESTINATION'

# The document's own change-tag vocabulary, as ordinary DEFs so that every
# DISPOSITION reference resolves through normal coherence.
DISPOSITIONS_BLOCK <- 'DISPOSITIONS' _ '{' _ (DEF_BLOCK _)* '}'

# Names the DOCUMENT uses that the edition it describes does not (a publisher
# typo, an inconsistent printing). §5b's ALIAS with a side qualifier: same
# entity, no value change. The alias name then resolves on that side, so units
# keep the document's own vocabulary while the alias records what it denotes.
#   ALIAS ^"Contract Patron" FOR DESTINATION ^"Level 9: Contact Patron"
ALIASES_BLOCK   <- 'ALIASES' _ '{' _ (BRIDGE_ALIAS _)* '}'
BRIDGE_ALIAS    <- 'ALIAS' _ CARET_REF _ 'FOR' _ SIDED_REF
                 / COMMENT

# ── Conversion rules ──────────────────────────────────────────
CONVERSION_BLOCK <- 'CONVERSION' _ '{' _ (CONVERSION_UNIT _)* '}'
CONVERSION_UNIT  <- MAP_UNIT / REMAINDER_UNIT / PROCEDURE_UNIT / COMMENT

MAP_UNIT        <- 'MAP' _ HASH_ID? _ '{' _ (MAP_FIELD _)* '}'
MAP_FIELD       <- SIDE_KW _ REFERENT_SET        # slot supplies the side
                 / 'SCOPE' _ SIDED_REF
                 / 'ASPECT' _ STRING
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

# A bulk disposition over every member of SCOPE that no MAP names.
# EXHAUSTIVE false records a hedging source ("Most magic items not listed…").
REMAINDER_UNIT  <- 'REMAINDER' _ HASH_ID? _ '{' _ (REMAINDER_FIELD _)* '}'
REMAINDER_FIELD <- 'SCOPE' _ SIDED_REF
                 / 'EXHAUSTIVE' _ BOOLEAN_LIT
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

# Converts the VALUES on a character sheet (MAP corresponds ENTITIES).
PROCEDURE_UNIT  <- 'PROCEDURE' _ HASH_ID? _ '{' _ (PROCEDURE_FIELD _)* '}'
PROCEDURE_FIELD <- 'SUBJECT' _ SIDED_REF
                 / 'ASPECT' _ STRING
                 / CONVERT_STMT
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT

CONVERT_STMT    <- 'CONVERT' _ SIDED_REF _ CONVERT_OP (_ 'INTO' _ SIDED_REF)?

# Closed operation vocabulary — deliberately NOT an expression language
# (the DSL guarantees a knowledge base, not a rules engine, §20).
CONVERT_OP      <- 'UNCHANGED'
                 / 'SCALE' _ INTEGER_LIT (_ 'OVER' _ INTEGER_LIT)?
                 / 'RESTATE'
                 / 'MANUAL' _ STRING

# ── Guidance ──────────────────────────────────────────────────
GUIDANCE_BLOCK  <- 'GUIDANCE' _ '{' _ (GUIDANCE_ENTRY _)* '}'

# The ENTRY caret is a LOCAL LABEL naming the passage, not a reference.
GUIDANCE_ENTRY  <- 'ENTRY' _ CARET_REF _ HASH_ID? _ '{' _ (GUIDANCE_FIELD _)* '}'
                 / COMMENT
# CONCERNS refs are SIDED_REF in a .bridge, or a (hash-qualified) caret in a .ttrpg
# (v0.5 generalization). DISPOSITION only occurs in a .bridge.
GUIDANCE_FIELD  <- 'CONCERNS' _ '[' _ GUIDANCE_REF (_ ',' _ GUIDANCE_REF)* _ ']'
                 / 'TOPICS' _ BRACKET_LIST
                 / DISPOSITION_FIELD
                 / TEXT_FIELD
                 / COMMENT
GUIDANCE_REF    <- SIDED_REF / (HASH_ID? _ CARET_REF)

# ── Shared bridge pieces ──────────────────────────────────────
# A disposition is a SET, not a single value: documents compose tags
# ("Magic Action [New Name, Revised Rule]").
DISPOSITION_FIELD <- 'DISPOSITION' _ '[' _ CARET_REF (_ ',' _ CARET_REF)* _ ']'

TEXT_FIELD      <- 'TEXT' _ STRING

# Inside an ORIGIN/DESTINATION slot the side is already fixed, so referents
# are bare; SIDED_REF is for slots that could mean either side.
REFERENT_SET    <- REFERENT / '[' _ REFERENT (_ ',' _ REFERENT)* _ ']'
REFERENT        <- CARET_REF / STRING
SIDED_REF       <- SIDE_KW _ REFERENT

# ═══════════════════════════════════════════════════════════
# 10. Values and Literals
# ═══════════════════════════════════════════════════════════

VALUE           <- CHOOSE_VALUE / STRING / INTEGER_LIT / BOOLEAN_LIT / CARET_REF / HASH_ID / BRACKET_LIST

INLINE_VALUE    <- STRING / CARET_REF

BRACKET_LIST    <- '[' _ BRACKET_ITEM (_ ',' _ BRACKET_ITEM)* _ ']'
BRACKET_ITEM    <- CHOOSE_VALUE / CARET_REF / HASH_ID / STRING / INTEGER_LIT / BOOLEAN_LIT

# CHOOSE n — a number of things are picked, and from what (v0.6, DECISION-15; replaces
# v0.4's CHOICE / PICK / WHERE). The count is always written.
#   CHOOSE 1 [ #hash ^"Demonic Might", #hash ^"Demonic Powers" ]     from a list
#   CHOOSE 1 [ "Charm", "Cunning" ]                                  options may be strings
#   CHOOSE 3 OF #hash ^"Virtue" WITH { ^"Size" ["Minor"] AND ^"Category" ["Supernatural"] }
#   CHOOSE 1 [ CHOOSE 1 OF ^"Virtue" WITH {…}, CHOOSE 3 OF ^"Virtue" WITH {…} ]   one or the other
# DISTINCT (the default) picks n different options; INDISTINCT lets one be picked again.
CHOOSE_VALUE    <- 'CHOOSE' (_ CHOOSE_MODE)? _ INTEGER_LIT _ (CHOOSE_LIST / CHOOSE_FROM_TYPE)
CHOOSE_MODE     <- 'DISTINCT' / 'INDISTINCT'
CHOOSE_LIST     <- '[' _ CHOOSE_OPTION (_ ',' _ CHOOSE_OPTION)* _ ']'
CHOOSE_OPTION   <- CHOOSE_VALUE / HASHED_REF / STRING
CHOOSE_FROM_TYPE <- 'OF' _ HASHED_REF (_ WITH_CLAUSE)?

# An entity option and an OF type are reference sites (§5d): the #hash is the referent.
HASHED_REF      <- (HASH_ID _)? CARET_REF

# WITH — what must be true of each entity chosen. A term is a property of the type and ONE
# value in brackets; it holds when the property has that value. A comma is not an implicit
# "or". One WITH joins its terms with AND throughout or OR throughout (the validator
# rejects a mix).
# TO-DO: nested conditions, A AND (B OR C), are not yet defined.
WITH_CLAUSE     <- 'WITH' _ '{' _ WITH_TERM (_ WITH_JOIN _ WITH_TERM)* _ '}'
WITH_JOIN       <- 'AND' / 'OR'
WITH_TERM       <- ('NOT' _)? CARET_REF _ '[' _ WITH_VALUE _ ']'
WITH_VALUE      <- HASHED_REF / STRING / INTEGER_LIT / BOOLEAN_LIT

# In place of a name: the value that follows applies to each option chosen.
#   ^"Ring Increase" DEF { CHOOSE 1 [ #hash ^"Earth", #hash ^"Fire" ] INTEGER 1 }
CHOOSE_KEYED    <- CHOOSE_VALUE _ PROPERTY_TYPE

# ═══════════════════════════════════════════════════════════
# 11. Terminals
# ═══════════════════════════════════════════════════════════

# String: double-quoted, with escape sequences
STRING          <- TRIPLE_QUOTED / SINGLE_QUOTED
TRIPLE_QUOTED   <- '"""' (!'"""' .)* '"""'
SINGLE_QUOTED   <- '"' STRING_CHAR* '"'
STRING_CHAR     <- '\\' ESCAPE_CHAR / !'"' .
ESCAPE_CHAR     <- ["\\/nrt] / 'u' HEX HEX HEX HEX
HEX             <- [0-9a-fA-F]

# §5c — embedded references *(v0.6, DECISION-20)*. A string is one token to the rules
# above. Its CONTENT may hold references, read after the string is lexed:
#   "… they also become ^\"Enraged\" (see page 272)."            cites ^"Enraged"; text: Enraged
#   "… fly into a ^\"Enraged\"/\"state of rage\" …"              cites ^"Enraged"; text: state of rage
#   "… become #hash ^\"Enraged\" …"                              cites it by its hash
# In a SINGLE_QUOTED string Q is the escaped quote; in a TRIPLE_QUOTED one it is the bare
# quote. The text of a string is its content with each EMBEDDED_REF read as its literal,
# or as its name where it has none.
STRING_CONTENT  <- (EMBEDDED_REF / .)*
EMBEDDED_REF    <- (HASH_ID ' '+)? '^' Q EMBEDDED_NAME Q ('/' Q EMBEDDED_LITERAL Q)?
EMBEDDED_NAME   <- (!Q .)+
EMBEDDED_LITERAL <- (!Q .)+
Q               <- '\\"' / '"'

# Integer: optional sign, digits
INTEGER_LIT     <- '-'? [0-9]+

# Boolean
BOOLEAN_LIT     <- 'true' / 'false'

# Caret reference: ^"Name", optionally with a parameter binding (DECISION-6).
# A bound ref fills a parameterized DEF's slots: ^"Puissant"(^"Single Weapon"),
# ^"Great"(^"Stamina"), ^"Area Lore"("Normandy"). Arguments bind positionally
# or by name (^"subject" = ^"Single Weapon"); each is a caret ref (an entity of
# the declared parameter type) or a string (a free-text slot). The derived
# display name ("Puissant Single Weapon") is rendered by consumers, not stored.
# A quote inside a name is escaped, as in a string (v0.6, DECISION-25):
#   ^"Mrinmoy \"Vidyapati\" Mishra"
CARET_REF       <- '^' '"' STRING_CHAR* '"' PARAM_BINDING?
PARAM_BINDING   <- _ '(' _ PARAM_ARG (_ ',' _ PARAM_ARG)* _ ')'
PARAM_ARG       <- (CARET_REF _ '=' _)? (CARET_REF / STRING)

# Hash ID: # followed by alphanumeric (no space after #)
# Distinguished from comments by: # + alphanum = hash ID, # + space = comment
HASH_ID         <- '#' [a-zA-Z0-9] [a-zA-Z0-9_]*

# Uppercase identifier (for system-defined keywords and generic blocks)
UPPER_IDENT     <- [A-Z] [A-Z0-9_]*
                   !{RESERVED_WORD}

# Note: UPPER_IDENT must not match reserved words when used as generic blocks.
# Reserved words are handled by their own rules with higher priority.

# ═══════════════════════════════════════════════════════════
# 12. Comments
# ═══════════════════════════════════════════════════════════

COMMENT         <- LINE_COMMENT / SLASH_COMMENT
LINE_COMMENT    <- '#' (' ' / &EOL) (!EOL .)*
SLASH_COMMENT   <- '//' (!EOL .)*

# ═══════════════════════════════════════════════════════════
# 13. Whitespace and Terminals
# ═══════════════════════════════════════════════════════════

_               <- (WHITESPACE / COMMENT)*
WHITESPACE      <- [ \t\r\n]+
EOL             <- '\r\n' / '\n' / '\r'
EOF             <- !.

# ═══════════════════════════════════════════════════════════
# Appendix: Reserved Words
# ═══════════════════════════════════════════════════════════
#
# These keywords are matched by dedicated rules and take priority
# over UPPER_IDENT / GENERIC_BLOCK:
#
# File-level:    BASE, EXTENSION, BRIDGE, EXTENDS, NAME, VERSION, SPEC_VERSION,
#                RELEASE_DATE, DEPENDS_ON, ORIGIN (v0.6, DECISION-26: a port's source;
#                shared with Bridge)
# Definition:    DEF, ACTOR, TEMPLATE, PROPERTIES, RULES
# Types:         STRING, INTEGER, BOOLEAN, ENUM, LIST, OF, REF            (REF: v0.6, DECISION-17)
# Dice:          FACES, WEIGHT, ROLL, NEXT                               (v0.6, DECISION-18)
# Changes:       SET, TRANSFORM, ADD, SUBTRACT, MULTIPLY, DIVIDE, ROUND, UP, DOWN,
#                NEAREST, MANUAL, MIN, MAX                               (v0.6, DECISION-16)
# Modifiers:     REQUIRED, FIXED, DEFAULT, MIN, MAX, FIAT
# Scope:         APPLIES, TO
# Rule:          WHEN, THEN
# Modification:  OVERRIDE, ADD, MODIFY, SET, ADD_TO, REMOVE_FROM, REPRINT
# Parameterize:  PARAMETERS, OF (also a type keyword), ALIAS, FOR   (DECISION-6)
# Choice:        CHOOSE, DISTINCT, INDISTINCT, OF, WITH, AND, OR, NOT   (v0.6, DECISION-15)
# References:    REFERENCES, MENTIONS (deprecated alias), REFERENCED, BY       (v0.5, §5c)
# Beside text:   EMPHASIS (v0.5), BOLD, ITALIC, LABEL                 (v0.6, §5c, DECISION-19)
# Tables:        TABLE, AXIS, AT, COLUMNS, ANY, MIN, MAX              (v0.6, §5e, DECISION-21)
# Hooks:         HOOKS, HOOK, FORMALITY, WHEN, TRIGGER, THEN,
#                PROSE, TAGGED, CONDITIONAL, FORMAL                            (v0.5, §23)
# Optional:      OPTIONAL, DEFAULT, SCOPE, GLOBAL, on, off                    (v0.5, §24)
# Selections:    SELECTIONS, SELECT, FOR (also alias kw), VERSION             (v0.5, §24)
# Codex (§25):   CODEX, SOURCES, CATEGORIES, RELATIONS, ENTITY, IS, RELATIONSHIPS,
#                INVERSE, DOMAIN, RANGE, SYMMETRIC, TRANSITIVE, SOURCE, AT, FROM,
#                EDITION, VERSION                                              (v0.5, §25)
# Guidance:      GUIDANCE, ENTRY, CONCERNS, TOPICS, TEXT (in a DEF/module now) (v0.5, §22)
# Text:          DESCRIPTION, TEXT
# Validation:    FIAT (also an element-level statement)
# Bridge (§21):  ORIGIN, DESTINATION, EXTERNAL, DISPOSITIONS, DISPOSITION, ALIASES,
#                CONVERSION, GUIDANCE, MAP, REMAINDER, PROCEDURE, SUBJECT,
#                SCOPE, ASPECT, CONCERNS, TOPICS, ENTRY, EXHAUSTIVE, CONVERT,
#                INTO, UNCHANGED, SCALE, OVER, RESTATE, MANUAL
