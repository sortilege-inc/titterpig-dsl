BRIDGE "Arm4_To_Arm5e_Appendix_I" {
    NAME "Ars Magica Fifth Edition, Appendix I: Fourth Edition Conversion"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-25"

    # The SPARSE case (cf. the SRD 5.2.1 bridge, the rich one). Appendix I is ~85%
    # prose and contains no entity-mapping table at all: no renames, no
    # substitutions, no bulk dispositions — so this bridge has no MAP and no
    # REMAINDER, and declares no DISPOSITIONS. A conversion document's change-tag
    # vocabulary is the DOCUMENT's, and this document declares none, so none is
    # invented here. What it does carry is seven field-level PROCEDUREs for
    # carrying a character across, plus the prose that explains the edition.

    # Ars Magica Fourth Edition has no titterpig corpus, so its references cannot
    # be resolved. They are written as caret references anyway: the day an arm4
    # corpus exists, the gate switches on for free.
    ORIGIN      "arm4"  VERSION "4" EXTERNAL "No titterpig corpus exists for Ars Magica Fourth Edition (Atlas Games, 1996); the origin edition is known only through this document."
    DESTINATION "arm5e" VERSION "0.4"

    CONVERSION {
        # ── Character Conversion, pp.224 ──────────────────────────────────────
        # The preamble is a rule of thumb, and conditional ("if you want to mix
        # characters"), so its arithmetic is encoded and its condition kept verbatim.
        PROCEDURE #bparm5eAgeConversion01 {
            SUBJECT ORIGIN ^"Age"
            TEXT "Fifth Edition characters tend to advance slightly more slowly than Fourth Edition. As a rule of thumb, if you want to mix characters, add 20% to a Fourth Edition character’s age, and then convert as follows."
            CONVERT ORIGIN ^"Age" SCALE 6 OVER 5 INTO DESTINATION ^"Starting Character Age"
        }

        PROCEDURE #bparm5eCharacteristics1 {
            SUBJECT ORIGIN ^"Characteristic"
            TEXT "**Characteristics:** Characteristics are unchanged between Fourth and Fifth Editions."
            CONVERT ORIGIN ^"Characteristic" UNCHANGED INTO DESTINATION ^"Characteristic"
        }

        # The source DELEGATES this one to the reader; MANUAL records that honestly
        # rather than pretending it was mechanized. It stays a conversion rule, not
        # guidance, because it is keyed to named fields.
        PROCEDURE #bparm5eVirtuesFlaws01 {
            SUBJECT ORIGIN ^"Virtue"
            TEXT "**Virtues and Flaws:** Convert each Virtue or Flaw to its new status. If this results in an unbalanced character, discuss suitable modifications with your troupe."
            CONVERT ORIGIN ^"Virtue" MANUAL "Convert each Virtue or Flaw to its new status." INTO DESTINATION ^"Virtue"
            CONVERT ORIGIN ^"Flaw" MANUAL "Convert each Virtue or Flaw to its new status." INTO DESTINATION ^"Flaw"
            CONVERT ORIGIN ^"Virtue" MANUAL "If this results in an unbalanced character, discuss suitable modifications with your troupe."
        }

        PROCEDURE #bparm5eAbilitiesConv01 {
            SUBJECT ORIGIN ^"Ability"
            TEXT "**Abilities:** Leave at the old value, and multiply remaining XP by five. Spread the XP from removed Abilities among the replacements, as desired."
            CONVERT ORIGIN ^"Ability" UNCHANGED INTO DESTINATION ^"Ability"
            CONVERT ORIGIN ^"Experience Points" SCALE 5 INTO DESTINATION ^"Using Experience Points"
            CONVERT ORIGIN ^"Experience Points" MANUAL "Spread the XP from removed Abilities among the replacements, as desired."
        }

        PROCEDURE #bparm5eArtsConversion1 {
            SUBJECT ORIGIN ^"Art"
            TEXT "**Arts:** No need to change."
            CONVERT ORIGIN ^"Art" UNCHANGED INTO DESTINATION ^"Art"
        }

        # "Note new levels" = take the destination edition's printed value, which is
        # what RESTATE means; the replacement clause is human judgement.
        PROCEDURE #bparm5eSpellsConvers1 {
            SUBJECT ORIGIN ^"Spell"
            TEXT "**Spells:** Note new levels. Spells a character can no longer cast (some have changed Arts) should be replaced with ones he can, of the same level as the old spell."
            CONVERT ORIGIN ^"Spell Level" RESTATE INTO DESTINATION ^"Level"
            CONVERT ORIGIN ^"Spell" MANUAL "Spells a character can no longer cast (some have changed Arts) should be replaced with ones he can, of the same level as the old spell." INTO DESTINATION ^"Formulaic Spell"
        }

        PROCEDURE #bparm5eTwilightConv01 {
            SUBJECT ORIGIN ^"Twilight Points"
            TEXT "**Twilight:** Divide the number of Twilight Points by three, and use this as the Warping Score."
            CONVERT ORIGIN ^"Twilight Points" SCALE 1 OVER 3 INTO DESTINATION ^"Warping Points and Score"
        }
    }

    GUIDANCE {
        ENTRY ^"Appendix I: Fourth Edition Conversion" #bgarm5eAppendixIIntro {
            TOPICS   [ "Fourth Edition Conversion" ]
            CONCERNS [ DESTINATION ^"Order of Hermes", DESTINATION ^"Mythic Europe" ]
            TEXT """
            Converting from **Ars Magica** 4th Edition to 5th Edition is a good idea, because a lot of longstanding problems in the rules have been fixed. However, that raises the question of what has changed. There are two viable short answers.
            """
        }

        ENTRY ^"Nothing has Changed" #bgarm5eNothingChanged {
            TOPICS   [ "Fourth Edition Conversion" ]
            CONCERNS [ DESTINATION ^"Order of Hermes", DESTINATION ^"Mythic Europe", DESTINATION ^"Hermetic Technique", DESTINATION ^"Hermetic Form", DESTINATION ^"Hermetic House" ]
            TEXT """
            The game is still about powerful wizards of the Order of Hermes, who live in covenants with Mythic Europe, a world where myth and history mix. Hermetic magic is still based on five Techniques and ten Forms. There are the same Houses of Hermes. Essentially, the summary of the game that you would give to someone who knew nothing about it is exactly the same as it was before. This is as it should be; this is a new edition, not a new game.
            """
        }

        ENTRY ^"Everything has Changed" #bgarm5eEverythingChg {
            TOPICS   [ "Fourth Edition Conversion" ]
            TEXT """
            On the other hand, the revisions have affected just about every part of the rules and background. Again, this is as it should be; this is a real new edition, not simply a republication with a different cover in the hope of getting people to buy the book again.
            """
        }

        ENTRY ^"The Long Answer" #bgarm5eTheLongAnswer {
            TOPICS   [ "Fourth Edition Conversion" ]
            TEXT """
            This chapter provides a summary of what has changed between the editions. It doesn’t cover everything, but it should give you an idea of the most important things to look at.
            """
        }

        ENTRY ^"Background" #bgarm5eApxIBackgrnd {
            TOPICS   [ "Fourth Edition Conversion", "Background" ]
            CONCERNS [ DESTINATION ^"Hermetic House", DESTINATION ^"Order of Hermes", DESTINATION ^"Mythic Europe" ]
            TEXT """
            The twelve Houses of Hermes are now split into three groups: four are Mystery Cults, four are True Lineages, and four are Societates, groups of magi with similar interests. They are still the same Houses as before, however.

            Beyond that, the background has changed very little. The Order of Hermes and Mythic Europe chapters have been completely rewritten, but the aim was to say things more clearly, not to say different things.
            """
        }

        ENTRY ^"Character Generation" #bgarm5eApxICharGen0 {
            TOPICS   [ "Fourth Edition Conversion", "Character Generation" ]
            # This passage concerns BOTH editions' virtues and flaws — the point
            # values are the origin's, the Major/Minor split the destination's — so
            # both sides are named. There is no default side (§21).
            CONCERNS [ ORIGIN ^"Virtue", ORIGIN ^"Flaw", DESTINATION ^"Virtue", DESTINATION ^"Flaw", DESTINATION ^"Personality Trait", DESTINATION ^"Ability", DESTINATION ^"Art", DESTINATION ^"Confidence", DESTINATION ^"Using Experience Points" ]
            TEXT """
            The rules for character generation are very different.

            First, Virtues and Flaws no longer have point values; they are split into Major and Minor. In addition, Flaws that create story hooks are now Major Flaws, unless they also have a benefit, in which case they are Minor. This means that a number of –1 Flaws have become Major Flaws, and a number of +1 Virtues have become Minor Flaws. Similarly, Personality Flaws are handled differently.

            Abilities now cost five times their (level + 1) to raise by one level. This means that the same advancement rules can be used for both Arts and Abilities.

            Characters get a different number of experience points at character generation. The overall result is that characters generated at a certain age, and characters played up to the same age, will be almost the same. This was very far from the case in Fourth Edition.

            The rules for Confidence have changed.
            """
        }

        ENTRY ^"Covenants" #bgarm5eApxICovenant {
            TOPICS   [ "Fourth Edition Conversion", "Covenants" ]
            CONCERNS [ DESTINATION ^"Covenant" ]
            TEXT """
            The rules for covenants have been totally redone. They are nothing like the Fourth Edition rules.
            """
        }

        ENTRY ^"Magic" #bgarm5eApxIMagic000 {
            TOPICS   [ "Fourth Edition Conversion", "Magic" ]
            CONCERNS [ DESTINATION ^"Penetration", DESTINATION ^"Magic Resistance", DESTINATION ^"Parma Magica", DESTINATION ^"Limit of Magic", DESTINATION ^"Hermetic Technique", DESTINATION ^"Hermetic Form", DESTINATION ^"Muto", DESTINATION ^"Rego", DESTINATION ^"Spell Mastery", DESTINATION ^"Certamen", DESTINATION ^"Spell Guideline", DESTINATION ^"Lab Total", DESTINATION ^"Lab Texts", DESTINATION ^"Target" ]
            TEXT """
            Spell level is now subtracted from the casting total before determining Penetration. This makes Magic Resistance, and in particular the Parma Magica, much more effective.

            The limits of magic have been clarified. The chances are that the official interpretation will differ slightly from your house rules interpretation, given how ambiguous the earlier wording was. The only deliberate change is that Hermetic magic is now incapable of scrying on the past or future.

            The scope of the Techniques and Forms has been clarified. In particular, Muto now deals with giving something a property it cannot naturally have, while Rego deals with giving something properties it can naturally have. As a result, spells have moved both ways between the Arts.

            Sympathetic magic for Penetration is now in the core rules.

            Spell mastery has been completely rewritten.

            Certamen no longer has an associated Ability.

            Vis boosting of spell ranges, durations, and targets has been cut.

            Spell ranges, durations, and targets have been changed and streamlined. The size of a target now has some effect on the spell level. Wards and magical senses are dealt with explicitly.

            The spell guidelines have been gone over thoroughly. Many spell levels have changed a bit, some have changed a lot.

            All laboratory activities now use the Lab Total. All Lab Texts use the same rules, and learning spells from texts is now a matter of inventing them based on a Lab Text.

            There are no separate rules for writing, copying, or learning spells: that is covered by the rules on Lab Texts.
            """
        }

        ENTRY ^"Long-Term Events" #bgarm5eApxILongTerm {
            TOPICS   [ "Fourth Edition Conversion", "Long-Term Events" ]
            CONCERNS [ DESTINATION ^"Aging", DESTINATION ^"Warping", DESTINATION ^"Wizard's Twilight", DESTINATION ^"Using Experience Points" ]
            TEXT """
            The study rules have been completely revised to get a more sensible advancement rate.

            Aging has been changed, to give a sensible distribution of ages at death, and to require less book-keeping.

            There are now actual rules for the bad effects of living in high auras or having spells cast on you constantly; this is called “Warping.” These rules integrate with the rules for Wizard’s Twilight, which is now the way that Warping affects Hermetic magi.
            """
        }

        ENTRY ^"Combat" #bgarm5eApxICombat00 {
            TOPICS   [ "Fourth Edition Conversion", "Combat" ]
            TEXT """
            Combat, as is traditional, has been completely rewritten.
            """
        }

        ENTRY ^"Character Conversion" #bgarm5eApxICharConv {
            TOPICS   [ "Fourth Edition Conversion", "Character Conversion" ]
            CONCERNS [ DESTINATION ^"Characteristic", DESTINATION ^"Virtue", DESTINATION ^"Flaw", DESTINATION ^"Ability", DESTINATION ^"Art", DESTINATION ^"Formulaic Spell", DESTINATION ^"Warping Points and Score" ]
            TEXT """
            Fifth Edition characters tend to advance slightly more slowly than Fourth Edition. As a rule of thumb, if you want to mix characters, add 20% to a Fourth Edition character’s age, and then convert as follows.

            **Characteristics:** Characteristics are unchanged between Fourth and Fifth Editions.

            **Virtues and Flaws:** Convert each Virtue or Flaw to its new status. If this results in an unbalanced character, discuss suitable modifications with your troupe.

            **Abilities:** Leave at the old value, and multiply remaining XP by five. Spread the XP from removed Abilities among the replacements, as desired.

            **Arts:** No need to change. **Spells:** Note new levels. Spells a character can no longer cast (some have changed Arts) should be replaced with ones he can, of the same level as the old spell.

            **Twilight:** Divide the number of Twilight Points by three, and use this as the Warping Score.
            """
        }
    }
}
