BRIDGE "Dnd5e_To_Dnd5_5e_Srd_Conversion" {
    NAME "Converting to System Reference Document 5.2.1"
    VERSION "2025.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2025-05-23"

    # A DIRECTED assertion of correspondence between two independent edition
    # namespaces (spec §21). Not reversible by inspection: several 5.1 stat
    # blocks collapse onto one 5.2.1 replacement, and every [New Rule] unit
    # has no origin to run back to.
    ORIGIN      "dnd5e"   VERSION "0.4"
    DESTINATION "dnd5.5e" VERSION "0.4"

    # The document declares its own change-tag vocabulary on page 1; these are
    # its words, not a vocabulary invented here.
    DISPOSITIONS {
        #bdddbcd3714532df4b8e ^"New Name" DEF {
            ^"Description" STRING "New Name. This tag is applied to a rule that has a new name. Unless stated otherwise, the rule hasn't changed apart from its name."
        }
        #bdffe0d5fb366b04eba6 ^"New Rule" DEF {
            ^"Description" STRING "New Rule. This tag indicates a new rule."
        }
        #bd8eed76ee2f4d9738a3 ^"Revised Rule" DEF {
            ^"Description" STRING "Revised Rule. This tag indicates a rule that appeared in SRD 5.1 but that has new functionality."
        }
        #bd178e78a95d3848bc12 ^"Omitted Rule" DEF {
            ^"Description" STRING "Additionally, the tag \"Omitted Rule\" indicates stat blocks that are omitted in SRD 5.2.1 but have recommended replacements."
        }
    }

    # Names this DOCUMENT uses that the edition it describes does not. The units
    # below keep the guide's own wording; these say what it denotes (spec §21).
    ALIASES {
        ALIAS ^"Contract Patron" FOR DESTINATION ^"Level 9: Contact Patron"
        ALIAS ^"Dark One’s Own Blessing" FOR DESTINATION ^"Level 3: Dark One's Blessing"
        ALIAS ^"Dark One’s Own Blessing" FOR ORIGIN      ^"Dark One's Blessing"
        ALIAS ^"Perfect Body" FOR ORIGIN      ^"Perfect Self"
    }

    CONVERSION {
        MAP #bmd615bcff912924c739 {
            ORIGIN      "D20 Test"
            DESTINATION ^"D20 Test"
            DISPOSITION [ ^"New Name" ]
            TEXT        "“D20 Test” is the new umbrella term for ability checks, attack rolls, and saving throws. If a rule applies to all three, you now use this term rather than listing all three terms."
        }
        MAP #bm8b8e7e73767c3e68e0 {
            DESTINATION ^"Heroic Inspiration"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "The inspiration rule has been replaced by Heroic Inspiration, which is a reroll rather than Advantage."
        }
        MAP #bmcd7ede9fd1aed77397 {
            ORIGIN      "Tool Proficiency"
            DESTINATION "Tool Proficiency"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "If you have proficiency with both the tool and the skill that are used for an ability check, you automatically have Advantage on the check, in addition to adding your Proficiency Bonus."
            FIAT        "Origin referent \"Tool Proficiency\" is untyped on purpose: this edition has no DEF for it in its own category, and the name is taken by an unrelated ^\"Tool Proficiency\" in dnd5e-0.5-races.ttrpg."
        }
        MAP #bm9097484fdcf28eab25 {
            ORIGIN      "Attack Action"
            DESTINATION ^"Attack"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The Attack action contains several revisions: The action now specifies that it involves an attack with a weapon or an Unarmed Strike. The action now allows you to equip or unequip one weapon with each attack you make with the action. The ability to move between attacks during combat is now a function of the Attack action rather than a general rule."
            FIAT        "Origin referent \"Attack Action\" is untyped on purpose: this edition has no DEF for it in its own category, and the name is taken by an unrelated ^\"Attack\" in dnd5e-0.5-monsters.ttrpg."
        }
        MAP #bm7317dd75a251b745d5 {
            ORIGIN      "Help"
            DESTINATION ^"Help"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Assisting an ally with an ability check is now limited by a creature’s skill and tool proficiencies as well as proximity to the ally."
        }
        MAP #bme00fcf7c191813669e {
            ORIGIN      ^"Hide"
            DESTINATION ^"Hide"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The rules for hiding have moved into the Hide action."
        }
        MAP #bmc5abae21acd5b5e16e {
            DESTINATION ^"Influence"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "The rules on influencing monsters through ability checks have moved into a new action: the Influence action."
        }
        MAP #bmad3efad118bf4d8bf0 {
            ORIGIN      "Magic Action"
            DESTINATION ^"Magic"
            DISPOSITION [ ^"New Name", ^"Revised Rule" ]
            TEXT        "The Magic action is used to cast a spell, use a magic item, or use a magical feature. The Cast a Spell action has been absorbed into this action. The descriptions of class features and magic items now use this action if they require an action to activate, and effects like Antimagic Field prevent this action’s use."
        }
        MAP #bm48618c75747b460379 {
            ORIGIN      "Search Action"
            DESTINATION ^"Search"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The previous Search action’s function has been divided into the Search action and the new Study action (see below). The new search action encompasses Wisdom checks to discern hidden things, such as Wisdom (Perception) checks to find a concealed creature."
        }
        MAP #bmdbdcf67ab8137b10c3 {
            DESTINATION ^"Study"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "The Study action encompasses Intelligence checks to recall something or study a book or other source of knowledge. Class features, such as the Wizard’s new Scholar feature, and other character benefits can now build on this action."
        }
        MAP #bm4a21fa835e812b631d {
            ORIGIN      "Utilize Action"
            DESTINATION ^"Utilize"
            DISPOSITION [ ^"New Name" ]
            TEXT        "The Use an Object action is now called the Utilize action."
        }
        MAP #bm2e6cac1a9b9ffb48ff {
            ORIGIN      "Surprise"
            DESTINATION ^"Surprise"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Being surprised no longer deprives you of the ability to act on your first turn of combat. Instead, being surprised causes you to have Disadvantage on your Initiative roll."
        }
        MAP #bm43b0e462e318048395 {
            ORIGIN      "Dropping Prone"
            DESTINATION "Dropping Prone"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "A creature can’t make itself Prone if its Speed is 0."
        }
        MAP #bmb0b7235eb534ac65cc {
            ORIGIN      "Moving around Other Creatures"
            DESTINATION "Moving around Other Creatures"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Here are the changes to this rule: You can move through the space of an Incapacitated creature. An ally’s space no longer counts as Difficult Terrain for you. You can now move through the space of a Tiny creature that isn’t an ally, and that creature’s space doesn’t count as Difficult Terrain for you. If you somehow end a turn in a space with another creature, you have the Prone condition unless you are Tiny or are of a larger size than the other creature."
        }
        MAP #bm26d0fa74019b260fe9 {
            ORIGIN      "Underwater Combat"
            DESTINATION "Underwater Combat"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Previously, a list of specific weapons avoided the Disadvantage that is imposed on the attack rolls of a creature that lacks a Swim Speed. In the revised rule, any weapon that deals Piercing damage avoids the Disadvantage."
        }
        MAP #bm9b10f11fd3f4b2531c {
            ORIGIN      "Saving Throws and Damage"
            DESTINATION "Saving Throws and Damage"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Previously, any effect that dealt damage to a group of targets simultaneously required the damage to be rolled once for all the targets. In the revised rules, that rule—rolling once for all the targets—applies only to saving throw effects."
        }
        MAP #bm4dd56646fb9d72a447 {
            ORIGIN      "Knocking Out a Creature"
            DESTINATION ^"Knocking Out a Creature"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "This rule now causes the Unconscious creature to have 1 Hit Point, not 0, and causes it to start a Short Rest. The Unconscious condition ends on the creature if it regains any Hit Points."
        }
        MAP #bm0d411c21f140b69659 {
            ORIGIN      "Note Armor Training"
            DESTINATION "Note Armor Training"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The ability to wear armor effectively is called armor training, not armor proficiency."
        }
        MAP #bm4e627a55141c837539 {
            ORIGIN      "Character Origin"
            DESTINATION "Character Origin"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Your character’s origin incorporates two items with revised rules: Choose a Background. Your choice of background provides several key rules elements: ability score increases, an Origin feat, skill and tool proficiencies, and some of your starting equipment. Choose a Species. Your choice of species, previously called race, provides certain traits and determines your character’s size and Speed. Species don’t provide ability score increases or languages, nor do species influence a character’s alignment. Additionally, the language tables are revised."
        }
        MAP #bma00ebf26bf924bc0cb {
            DESTINATION "Character Origin"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "Your character’s origin incorporates a new item: Choose Languages. All characters choose two languages in addition to Common. These choices are independent of background and species selection. The choices of standard languages and rare languages are revised. Additionally, Common Sign Language is a new language."
        }
        MAP #bmef30752c0d483ab272 {
            ORIGIN      "Adjust Ability Scores"
            DESTINATION "Adjust Ability Scores"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "Ability score adjustments come from a character’s background, not from the character’s species."
        }
        MAP #bm064afc11cfaf398796 {
            ORIGIN      "Step 5: Character Creation Details"
            DESTINATION "Step 5: Character Creation Details"
            DISPOSITION [ ^"New Name", ^"Revised Rule" ]
            TEXT        "Several rules have been consolidated into this step under the name “Fill In Numbers.” These rules include noting proficiency in saving throws and skills, determining starting Hit Points, and explaining spellcasting rules that apply to all spellcasting classes."
        }
        MAP #bmc15537b6879390cedd {
            ORIGIN      "Fixed Hit Points By Class"
            DESTINATION ^"Fixed Hit Points by Class"
            DISPOSITION [ ^"New Name" ]
            TEXT        "Fixed Hit Points received by each class are presented here under this new name, rather than in each class’s features."
        }
        MAP #bma267831b4ac51d342b {
            DESTINATION "Tiers of Play"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "The description of tiers of play is new."
        }
        MAP #bm8d15b42d5212bec383 {
            DESTINATION "Starting at Higher Levels"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "This section, including the “Starting Equipment at Higher Levels” table and the “Bonus Feats at Level 20” sidebar, is new."
        }
        MAP #bm45e6f6614aadc77a72 {
            ORIGIN      "Prerequisites"
            DESTINATION "Prerequisites"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The ability score prerequisites for multiclassing now appear in each class description, so this rule refers to the class descriptions."
        }
        MAP #bm9c56709ed08b428673 {
            ORIGIN      "Proficiencies"
            DESTINATION ^"Proficiency"
            DISPOSITION [ ^"Revised Rule" ]
            TEXT        "The proficiencies and armor training you gain for multiclassing now appear in each class description, so this rule refers to the class descriptions."
        }
        MAP #bm3c3fae9cb14f8bbf78 {
            ORIGIN      "Armor Class"
            DESTINATION ^"Armor Class"
            DISPOSITION [ ^"New Name", ^"Revised Rule" ]
            TEXT        "This rule now clarifies that it applies to any feature that calculates your Armor Class differently, not just the Unarmored Defense class feature."
        }
        MAP #bm378e25101f8a495016 {
            DESTINATION ^"Trinkets"
            DISPOSITION [ ^"New Rule" ]
            TEXT        "This section and its table are new."
        }
        MAP #bm6e159af90d3d32885f {
